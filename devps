EOF
}

# Sorting by a column that is zero for every row is not a ranking, it is the
# snapshot's own order wearing a SWAP HOGS heading. Say why instead.
swap_cmd() {
  if [ "$DP_PLATFORM" != linux ]; then
    die "per-process swap is not available on $(uname -s).
       It compresses memory rather than swapping per process, so there is no
       per-pid figure to rank - the SWAP column reads - for the same reason.
       try: $PROG top"
  fi
  header
  proc_table "SWAP HOGS" "$1" swap "" 1
}

report() {
  SNAP=$(snapshot)
  header
  ports_table
  group_table
  proc_table "TOP PROCESSES" "${1:-12}" rss "" 1
  printf '%s  %s help for commands - nothing above changed anything.%s\n' \
    "$C_DIM" "$PROG" "$C_0"
}

# ------------------------------------------------------------------- main ----
# Global flags are stripped here so no subcommand parser has to know about
# them. --redact is exported rather than passed: the awk that does the masking
# reads it from the environment.
_argv=()
for _a in "$@"; do
  case "$_a" in
    --redact) export DEVPS_REDACT=1 ;;
    *)        _argv+=("$_a") ;;
  esac
done
set -- ${_argv[@]+"${_argv[@]}"}

cmd="${1:-report}"
if [ $# -gt 0 ]; then shift; fi

case "$cmd" in
  help|-h|--help)  usage ;;
  version|-V)      echo "$PROG $VERSION" ;;
  report)          report "${1:-12}" ;;
  top)             header; proc_table "TOP PROCESSES" "${1:-15}" rss "" 1 ;;
  swap)            swap_cmd "${1:-15}" ;;
  idle)            idle_cmd ;;
  projects|proj)   header; projects_cmd ;;
  doctor|dr)       doctor_cmd ;;
  group|g)
      [ $# -ge 1 ] || die "usage: $PROG group <${DP_GROUPS// /|}>"
      valid_group "$1" || die "unknown group '$1' (valid: $DP_GROUPS)"
      proc_table "$(echo "$1" | tr '[:lower:]' '[:upper:]') PROCESSES" 200 rss "$1" 0 ;;
  ports)           ports_table ;;
  port)            [ $# -ge 1 ] || die "usage: $PROG port <n>"; port_cmd "$1" ;;
  tree)            [ $# -ge 1 ] || die "usage: $PROG tree <pid>"; tree_cmd "$1" ;;
  kill|k)          kill_cmd "$@" ;;
  dash|d|watch|w)  dash_cmd "${1:-2}" ;;
  -*)              nocolour; report ;;
  *)               die "unknown command '$cmd' - try: $PROG help" ;;
esac
