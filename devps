#!/usr/bin/env bash
# devps - see what your dev machine is running, what it costs, and stop it safely.
# Linux and WSL2 read /proc; macOS reads sysctl, vm_stat and lsof.
# Dependencies: bash 4+, ps, pgrep, awk, and iproute2 (Linux) or lsof (macOS).
#
# Formerly wslps. Invoked under either name: PROG is what the user typed, so a
# wslps symlink still describes itself as wslps in its own help and errors.

set -uo pipefail
VERSION=2.1.0
PROG=${0##*/}

# ---------------------------------------------------------------- colour ----
# UI_COLOR   0 plain, 1 sixteen colours, 2 two-hundred-and-fifty-six
# UI_UNICODE block-drawing glyphs are safe to emit
UI_COLOR=0; UI_UNICODE=0
RAMP=(); BLK=(); SPK=(); SPIN=(); BAR_EMPTY="."

# One colour per group, so a group reads the same in every table it appears in.
# Categorical, not a heat scale: these say "what kind of thing", while the RAM
# and CPU columns keep green/amber/red for "how much".
declare -A GCOL=()
GCOLS_STR=""

group_palette() {
  local g
  GCOL=()
  if [ "$UI_COLOR" -ge 2 ]; then
    GCOL[mcp]=$'\033[38;5;203m'        # red
    GCOL[ai-agent]=$'\033[38;5;214m'   # orange
    GCOL[dev-server]=$'\033[38;5;45m'  # azure
    GCOL[browser]=$'\033[38;5;75m'     # blue
    GCOL[editor]=$'\033[38;5;141m'     # violet
    GCOL[database]=$'\033[38;5;221m'   # gold
    GCOL[webserver]=$'\033[38;5;79m'   # teal
    GCOL[node]=$'\033[38;5;114m'       # green
    GCOL[system]=$'\033[38;5;240m'     # dark grey - quieter than other
    GCOL[other]=$'\033[38;5;244m'      # grey
  elif [ "$UI_COLOR" -eq 1 ]; then
    GCOL[mcp]=$'\033[31m'      GCOL[ai-agent]=$'\033[33m'
    GCOL[dev-server]=$'\033[36m'  GCOL[browser]=$'\033[34m'
    GCOL[editor]=$'\033[35m'   GCOL[database]=$'\033[1;33m'
    GCOL[webserver]=$'\033[1;36m' GCOL[node]=$'\033[32m'
    GCOL[system]=$'\033[37m'  GCOL[other]=$'\033[2m'
  fi
  # flattened for awk: group=escape|group=escape|...
  GCOLS_STR=""
  for g in "${!GCOL[@]}"; do GCOLS_STR+="${g}=${GCOL[$g]}|"; done
}

palette() {
  if [ "$UI_COLOR" -ge 2 ]; then
    C_DIM=$'\033[38;5;244m'; C_B=$'\033[1m'
    C_R=$'\033[38;5;203m';   C_Y=$'\033[38;5;221m'
    C_G=$'\033[38;5;114m';   C_C=$'\033[38;5;80m'
    C_ACC=$'\033[38;5;147m'; C_HEAD=$'\033[1;38;5;231m'
    C_TRACK=$'\033[38;5;237m'
    C_NEW=$'\033[38;5;84m';  C_0=$'\033[0m'
    # green -> lime -> amber -> red, walked along the length of a bar
    RAMP=(78 78 114 114 148 148 184 184 214 214 208 208 203 203 197 197)
  elif [ "$UI_COLOR" -eq 1 ]; then
    C_DIM=$'\033[2m';  C_B=$'\033[1m';  C_R=$'\033[31m'; C_Y=$'\033[33m'
    C_G=$'\033[32m';   C_C=$'\033[36m'; C_ACC=$'\033[35m'; C_HEAD=$'\033[1m'
    C_TRACK=$'\033[2m'; C_NEW=$'\033[32m'; C_0=$'\033[0m'
    RAMP=()
  else
    C_DIM=""; C_B=""; C_R=""; C_Y=""; C_G=""; C_C=""; C_ACC=""; C_HEAD=""
    C_TRACK=""; C_NEW=""; C_0=""
    RAMP=()
  fi
  if [ "$UI_UNICODE" = 1 ]; then
    BLK=("▏" "▎" "▍" "▌" "▋" "▊" "▉" "█")
    SPK=("▁" "▂" "▃" "▄" "▅" "▆" "▇" "█")
    SPIN=("⠋" "⠙" "⠹" "⠸" "⠼" "⠴" "⠦" "⠧" "⠇" "⠏")
    BAR_EMPTY="░"
  else
    BLK=("#" "#" "#" "#" "#" "#" "#" "#")
    SPK=("_" "." "." "-" "-" "=" "=" "^")
    SPIN=("|" "/" "-" "\\")
    BAR_EMPTY="."
  fi
  group_palette
}

ui_detect() {
  UI_COLOR=0; UI_UNICODE=0
  if [ -t 1 ] && [ "${NO_COLOR:-}" = "" ] && [ "${TERM:-dumb}" != dumb ]; then
    UI_COLOR=1
    case "${COLORTERM:-}|${TERM:-}" in
      *truecolor*|*24bit*|*256color*|*kitty*|*alacritty*|*wezterm*|*ghostty*|*vscode*)
        UI_COLOR=2 ;;
    esac
    case "${LC_ALL:-${LC_CTYPE:-${LANG:-}}}" in
      *UTF-8*|*utf-8*|*utf8*|*UTF8*) UI_UNICODE=1 ;;
    esac
  fi
  [ "${DEVPS_ASCII:-${WSLPS_ASCII:-}}" = "" ] || UI_UNICODE=0
  palette
}
ui_detect

nocolour() { UI_COLOR=0; UI_UNICODE=0; palette; }

die() { printf '%s%s: %s%s\n' "$C_R" "$PROG" "$*" "$C_0" >&2; exit 2; }

# ------------------------------------------------------------- bar drawing ----
# _abar <permille 0-1000> [width] - gradient bar with eighth-cell tips.
# The _-prefixed workers leave their result in REPLY and fork nothing; the
# render loop calls those. The plain names print, for one-shot output.
_abar() {
  local pm=$1 w=${2:-24} out="" i cells full frac ci last="" nr=${#RAMP[@]}
  [ "$pm" -lt 0 ] && pm=0
  [ "$pm" -gt 1000 ] && pm=1000
  cells=$(( pm * w * 8 / 1000 ))
  full=$(( cells / 8 )); frac=$(( cells % 8 ))
  for (( i = 0; i < w; i++ )); do
    if [ "$i" -lt "$full" ] || { [ "$i" -eq "$full" ] && [ "$frac" -gt 0 ]; }; then
      if [ "$nr" -gt 0 ]; then
        ci=${RAMP[$(( i * nr / w ))]}
        if [ "$ci" != "$last" ]; then out+=$'\033[38;5;'"${ci}m"; last=$ci; fi
      elif [ -z "$last" ] && [ "$UI_COLOR" -ge 1 ]; then
        out+="$C_G"; last=x
      fi
      if [ "$i" -lt "$full" ]; then out+="${BLK[7]}"; else out+="${BLK[$(( frac - 1 ))]}"; fi
    else
      if [ "$last" != track ]; then out+="$C_0$C_TRACK"; last=track; fi
      out+="$BAR_EMPTY"
    fi
  done
  REPLY="${out}${C_0}"
}
abar() { _abar "$@"; printf '%s' "$REPLY"; }

# _spark <array name> [full-scale] - sparkline over the sample history.
# Pass the scale for a percentage series: auto-scaling makes a flat 40% look
# like a pegged 100%, which is a lie a resource monitor cannot afford.
_spark() {
  local -n vals=$1
  local out="" v mx=${2:-0} budget=${3:-32} n=${#vals[@]} idx col last=""
  # the slice below is a negative offset: asking for more than the array holds
  # is an expansion error, not a short read
  [ "$budget" -gt "$n" ] && budget=$n
  if [ "$budget" -lt 1 ]; then REPLY=""; return 0; fi
  [ "$mx" -gt 0 ] || for v in "${vals[@]}"; do [ "$v" -gt "$mx" ] && mx=$v; done
  [ "$mx" -gt 0 ] || mx=1
  # keep the newest samples: a truncated sparkline should lose its left edge
  for v in "${vals[@]: -budget}"; do
    idx=$(( v * 7 / mx )); [ "$idx" -lt 0 ] && idx=0
    if [ "$UI_COLOR" -ge 2 ]; then
      case $(( v * 100 / (mx > 0 ? mx : 1) )) in
        100|9[0-9]|8[0-9]) col=$'\033[38;5;203m' ;;
        7[0-9]|6[0-9])     col=$'\033[38;5;214m' ;;
        5[0-9]|4[0-9])     col=$'\033[38;5;148m' ;;
        *)                 col=$'\033[38;5;78m'  ;;
      esac
      if [ "$col" != "$last" ]; then out+="$col"; last=$col; fi
    fi
    out+="${SPK[$idx]}"
  done
  REPLY="${out}${C_0}"
}
spark() { _spark "$@"; printf '%s' "$REPLY"; }

# _humb <kb> - human size with no awk and no subshell
_humb() {
  local kb=$1
  if   [ "$kb" -ge 1073741824 ]; then printf -v REPLY '%d.%dT' $(( kb / 1073741824 )) $(( kb % 1073741824 * 10 / 1073741824 ))
  elif [ "$kb" -ge 1048576 ];    then printf -v REPLY '%d.%dG' $(( kb / 1048576 ))    $(( kb % 1048576 * 10 / 1048576 ))
  elif [ "$kb" -ge 1024 ];       then printf -v REPLY '%dM'    $(( kb / 1024 ))
  else                                printf -v REPLY '%dK'    "$kb"
  fi
}
humb() { _humb "$1"; printf '%s' "$REPLY"; }

# ------------------------------------------------------------- awk shared ----
AWKLIB='
function hum(kb,   v, u, i) {
  v = kb + 0; split("K M G T", u, " "); i = 1
  while (v >= 1024 && i < 4) { v /= 1024; i++ }
  if (v >= 100 || i == 1) return sprintf("%d%s", v + 0.5, u[i])
  return sprintf("%.1f%s", v, u[i])
}
function dur(s,   d, h, m) {
  d = int(s / 86400); s %= 86400
  h = int(s / 3600);  s %= 3600
  m = int(s / 60)
  if (d) return sprintf("%dd%dh", d, h)
  if (h) return sprintf("%dh%02dm", h, m)
  return sprintf("%dm", m)
}
function gcol(g) {
  if (!gc_ready) {
    gc_ready = 1
    gc_n = split(GCOLS, gc_a, "|")
    for (gc_i = 1; gc_i <= gc_n; gc_i++)
      if (split(gc_a[gc_i], gc_b, "=") == 2) GC[gc_b[1]] = gc_b[2]
  }
  return (g in GC) ? GC[g] : ""
}
# Mask secrets in a command line when DEVPS_REDACT is set. Read from the
# environment rather than passed in, so the nine call sites do not each need
# their own -v. Two shapes cover what actually leaks into a process list: a URL
# userinfo, and a KEY=VALUE whose key names a secret. The username survives -
# it is the half that tells you which service this is.
#
# Splitting on single spaces collapses runs of them. Command lines rarely carry
# those, and a redacted line is being read, not re-executed.
function redact(s,   n, a, i, j, t, k, p, rest, slash, at, ui, c, out) {
  if (ENVIRON["DEVPS_REDACT"] == "") return s
  n = split(s, a, " ")
  out = ""
  for (i = 1; i <= n; i++) {
    t = a[i]
    # [^:/]* not + : redis://:password@host omits the username entirely
    if (t ~ /:\/\/[^:\/]*:[^\/]+@/) {
      p = index(t, "://"); rest = substr(t, p + 3)
      # the userinfo ends at the LAST @ before the path, not the first: a
      # password may contain @, and taking the first one leaks its tail
      slash = index(rest, "/"); if (slash == 0) slash = length(rest) + 1
      at = 0
      for (j = 1; j < slash; j++) if (substr(rest, j, 1) == "@") at = j
      if (at > 0) {
        ui = substr(rest, 1, at - 1); c = index(ui, ":")
        if (c > 0)
          t = substr(t, 1, p + 2) substr(ui, 1, c) "***" substr(rest, at)
      }
    }
    if (match(t, /=/)) {
      k = substr(t, 1, RSTART - 1)
      if (tolower(k) ~ /pass|pwd|token|secret|credential|api[-_]?key/) t = k "=***"
    }
    out = out (i > 1 ? " " : "") t
  }
  return out
}
function shorten(a, w,   s) {
  s = redact(a)
  sub(/^\/[^ ]*\//, "", s)
  gsub(/\/home\/[^\/]+\//, "~/", s)
  gsub(/\/Users\/[^\/]+\//, "~/", s)
  if (w > 3 && length(s) > w) s = substr(s, 1, w - 3) "..."
  return s
}
'

DP_GROUPS="mcp ai-agent dev-server browser editor database webserver node system other"

# The group classifier, shared by every snapshot implementation. A process must
# land in the same group whichever kernel reported it, or the group table means
# two different things on two machines.
#
# Each platform names the same software differently: an editor is a
# .vscode-server directory under WSL and a Code Helper process bundle on macOS,
# and Chrome is /opt/google/chrome on one and "Google Chrome.app" on the other.
# The patterns are additive - both spellings live in the same branch.
# [[DD-]HH:]MM:SS[.ss] -> seconds. Darwin's ps hands out both etime and time as
# clock strings. The day component is added after the base-60 walk; folding it
# into the accumulator multiplies it by 60 once per remaining field.
AWKSECS='
function secs(t,   d, p, n, v, i) {
  d = 0
  if (t ~ /-/) { split(t, p, "-"); d = p[1] + 0; t = p[2] }
  n = split(t, p, ":")
  v = 0
  for (i = 1; i <= n; i++) v = v * 60 + (p[i] + 0)
  return v + d * 86400
}
'

AWKCAT='
function cat(a,   l, exe) {
  l = tolower(a)
  # the official packages spell it out: "@modelcontextprotocol/server-postgres"
  # contains no "mcp", so it used to fall through to the postgres branch and be
  # counted as a database. Every other spelling in the wild - mcp-server-x,
  # x-mcp, fastmcp, mcp_server_x - already carries the three letters.
  if (l ~ /mcp|modelcontextprotocol/)                               return "mcp"
  if (l ~ /(^|\/)claude([ \t]|$)|claude-code|(^|\/)codex([ \t]|$)|cursor-agent/) return "ai-agent"
  if (l ~ /next-server|next dev|\.next\/|vite|nuxt|astro|webpack|remix|(^|\/)turbo([ \t]|$)/) return "dev-server"
  if (l ~ /\/chrome|chromium|firefox|msedge|playwright|puppeteer/)   return "browser"
  if (l ~ /google chrome|safari\.app|webkit\.framework/)             return "browser"
  if (l ~ /\.vscode-server|\.cursor-server/)                         return "editor"
  if (l ~ /visual studio code|code helper|cursor helper|zed\.app|sublime text/) return "editor"
  if (l ~ /mysqld|postgres|redis-server|mariadb|mongod/)             return "database"
  if (l ~ /apache2|nginx|php-fpm|httpd/)                             return "webserver"
  if (l ~ /(^|\/)node([ \t]|$)|(^|\/)npm |(^|\/)pnpm |yarn|(^|\/)bun([ \t]|$)/) return "node"
  # Processes the OS started, which you did not and cannot usefully stop. This
  # is deliberately the last test before "other", so it can only ever reclaim
  # rows that were going to be unclassified - /usr/sbin/nginx is still a
  # webserver and /usr/sbin/mysqld is still a database, because those branches
  # ran first. Matching on install prefix rather than name: the set of daemon
  # names is unbounded, the directories they live in are not.
  # Only the executable decides this, never an argument: "/opt/tool --name
  # com.apple.fake" is not a system process, and "/home/alice/cron" is not cron.
  exe = l; sub(/[ \t].*/, "", exe)
  if (exe ~ /^\/system\/|^\/library\/apple\/|^\/usr\/libexec\/|^\/usr\/sbin\/|^\/usr\/lib\/|^\/sbin\/|^\/lib\//) return "system"
  if (exe ~ /^com\.apple\./) return "system"
  # a bare daemon name, with no path at all - a path-qualified one had to match
  # a system prefix above to count
  if (exe !~ /\// && exe ~ /^(systemd|systemd-[a-z]+|launchd|dbus-daemon|rsyslogd|udevd|agetty|sshd|cron)$/) return "system"
  return "other"
}
'

# --------------------------------------------------------------- platform ----
# Everything above reads nothing; everything below asks the box a question, and
# the two kernels answer in different places. Each reader gets one function per
# platform and a dispatcher, picked once here rather than re-tested per call.
#
# snapshot is the contract that matters. Every table, view and dashboard row is
# built from its ten columns, and none of them know which kernel filled them.
# A platform that cannot answer a column reports 0 rather than guessing - a
# wrong swap figure is worse than an absent one.
case "$(uname -s)" in
  Linux)  DP_PLATFORM=linux  ;;
  Darwin) DP_PLATFORM=darwin ;;
  *)      DP_PLATFORM=linux  ;;   # best effort - assume a /proc filesystem
esac

# Does this pid still exist. Linux keeps the cheap read: /proc/<pid>/stat is
# world readable, so it answers "exists", not "is mine". ps is the portable
# equivalent with those same semantics - kill -0 is not, it fails with EPERM
# on a live process owned by another user, which would read here as death.
pid_alive() {
  if [ "$DP_PLATFORM" = linux ]; then
    [ -r "/proc/$1/stat" ]
  else
    ps -o pid= -p "$1" >/dev/null
  fi
}

# What the header calls the box. Purely cosmetic, but "WSL RESOURCES" over a
# macOS process list is a lie the rest of the output has to live down.
case "$DP_PLATFORM" in
  darwin) DP_LABEL="MACOS" ;;
  *)      DP_LABEL="WSL"   ;;
esac

cpu_cores_linux()  { nproc; }
cpu_cores_darwin() { sysctl -n hw.ncpu; }
cpu_cores() { "cpu_cores_$DP_PLATFORM"; }

# three space separated averages, 1 / 5 / 15 minutes
loadavg_linux()  { local a b c; read -r a b c _ < /proc/loadavg; printf '%s %s %s\n' "$a" "$b" "$c"; }
loadavg_darwin() { sysctl -n vm.loadavg | tr -d '{}'; }
loadavg() { "loadavg_$DP_PLATFORM"; }

uptime_secs_linux()  { local s; read -r s _ < /proc/uptime; printf '%d\n' "${s%%.*}"; }
uptime_secs_darwin() {
  local b
  # anchored at the brace: an unanchored .*sec runs greedily to usec instead
  b=$(sysctl -n kern.boottime | sed -n 's/^{ *sec *= *\([0-9]*\).*/\1/p')
  [ -n "$b" ] || { printf '0\n'; return; }
  printf '%d\n' "$(( $(date +%s) - b ))"
}
uptime_secs() { "uptime_secs_$DP_PLATFORM"; }

# "5 hours, 15 minutes" - Darwin has no uptime -p, so the phrasing is rebuilt
# rather than the format changed, which would move it on Linux too
uptime_pretty_linux() { uptime -p | sed 's/^up //'; }
uptime_pretty_darwin() {
  local s d h m out=""
  s=$(uptime_secs)
  d=$(( s / 86400 )); h=$(( s % 86400 / 3600 )); m=$(( s % 3600 / 60 ))
  [ "$d" -gt 0 ] && out="$d $(plural day "$d")"
  [ "$h" -gt 0 ] && out="${out:+$out, }$h $(plural hour "$h")"
  if [ "$m" -gt 0 ] || [ -z "$out" ]; then out="${out:+$out, }$m $(plural minute "$m")"; fi
  printf '%s\n' "$out"
}
plural() { if [ "$2" = 1 ]; then printf '%s' "$1"; else printf '%ss' "$1"; fi; }
uptime_pretty() { "uptime_pretty_$DP_PLATFORM"; }

# processes blocked in an uninterruptible wait - Linux calls that state D,
# Darwin calls it U. Only consulted on a kernel without PSI.
# pgrep cannot filter on process state, so ps + grep is the right tool here
# shellcheck disable=SC2009
dstate_count_linux()  { ps -eo stat= | grep -c '^D' || true; }
# shellcheck disable=SC2009
dstate_count_darwin() { ps -eo stat= | grep -c '^U' || true; }
dstate_count() { "dstate_count_$DP_PLATFORM"; }

# total / available / swap total / swap free, in KB, on one line.
#
# Linux publishes MemAvailable. Darwin does not, so it is rebuilt from vm_stat
# as free plus the page classes the kernel can reclaim without swapping:
# inactive (largely file backed) and speculative. That follows what
# MemAvailable means rather than what Activity Monitor shows, which counts
# compressed pages as used and would not compare against the Linux number.
#
# Purgeable is deliberately not added. It is a volatility attribute of a VM
# object, not a page queue: memory_pressure(1) lists active, inactive,
# speculative, throttled and wired under "Page Q counts" and leaves purgeable
# out for that reason. Its pages are already counted on the queue they sit on,
# so adding it double counts them and overstates what is available - which for
# a tool whose job is warning about memory pressure is the dangerous direction
# to be wrong in. Erring low costs a warning too early; erring high costs the
# warning entirely.
#
# Page size comes out of vm_stat's own header: 16K on Apple silicon, 4K on
# Intel, and hardcoding either is wrong on the other machine.
darwin_mem_kb() {
  local memsize swap
  memsize=$(sysctl -n hw.memsize)
  swap=$(sysctl -n vm.swapusage)
  vm_stat | awk -v memsize="$memsize" -v swap="$swap" '
    function kb(v,   n, u) {
      n = v + 0; u = substr(v, length(v))
      if (u == "G") return n * 1048576
      if (u == "M") return n * 1024
      if (u == "K") return n
      return n / 1024
    }
    NR == 1 && match($0, /page size of [0-9]+/) {
      ps = substr($0, RSTART + 13, RLENGTH - 13) + 0
    }
    /^Pages free:/        { free  = $3 + 0 }
    /^Pages inactive:/    { inact = $3 + 0 }
    /^Pages speculative:/ { spec  = $3 + 0 }
    END {
      if (ps <= 0) ps = 4096
      split(swap, w, " ")     # total = N  used = N  free = N  (encrypted)
      printf "%d %d %d %d\n", memsize / 1024,
             (free + inact + spec) * ps / 1024, kb(w[3]), kb(w[9])
    }'
}

meminfo_linux() { awk -v k="$1" '$1 == k":" { print $2; exit }' /proc/meminfo; }
meminfo_darwin() {
  local t a st sf
  read -r t a st sf <<< "$(darwin_mem_kb)"
  case "$1" in
    MemTotal)     printf '%s\n' "${t:-1}"  ;;
    MemAvailable) printf '%s\n' "${a:-0}"  ;;
    SwapTotal)    printf '%s\n' "${st:-0}" ;;
    SwapFree)     printf '%s\n' "${sf:-0}" ;;
    *)            printf '0\n'             ;;
  esac
}
meminfo() { "meminfo_$DP_PLATFORM" "$@"; }

# Every listening TCP socket as "port<TAB>pid", pid empty when the socket
# belongs to another user. Five callers used to run ss and re-derive this pair
# with the same five-line awk; the parsing lives here once instead.
listeners_linux() {
  ss -tlnpH | awk '
    { n = split($4, a, ":"); pid = ""
      if (match($0, /pid=[0-9]+/)) pid = substr($0, RSTART + 4, RLENGTH - 4)
      printf "%s\t%s\n", a[n], pid }'
}

# lsof field output rather than its columns: -Fpn emits one p<pid> line per
# process followed by an n<addr:port> line per socket, which survives command
# names containing spaces. Sockets owned by another user are simply absent
# without privileges, where ss lists them with no pid - so the "another user"
# hint in the ports table is Linux only, not wrong here.
listeners_darwin() {
  lsof -w -nP -iTCP -sTCP:LISTEN -Fpn | awk '
    /^p/ { pid = substr($0, 2); next }
    /^n/ { n = substr($0, 2); k = split(n, a, ":")
           if (a[k] ~ /^[0-9]+$/) printf "%s\t%s\n", a[k], pid }'
}

listeners() { "listeners_$DP_PLATFORM" | sort -n -u; }

# a process's working directory, or empty when it cannot be read
proc_cwd_linux()  { readlink "/proc/$1/cwd"; }
proc_cwd_darwin() { lsof -w -a -d cwd -Fn -p "$1" | sed -n 's/^n//p' | head -1; }
proc_cwd() { "proc_cwd_$DP_PLATFORM" "$1"; }

# the group list, each name in its own colour - doubles as the colour legend
group_legend() {
  local g out=""
  for g in $DP_GROUPS; do out+="${GCOL[$g]:-}${g}${C_0} "; done
  printf '%s' "$out"
}

# ------------------------------------------------------------------- psi ----
# Pressure Stall Information: the share of the last 10s in which tasks were
# stalled waiting for a resource. "some" means at least one task was blocked,
# "full" means every non-idle task was - which is the kernel's own definition
# of thrashing. Load average cannot tell CPU contention from IO stall because
# it counts uninterruptible tasks too, so PSI is what the warnings below use
# whenever the kernel provides it. Values are kept as hundredths of a percent.
PSI_OK=0
PSI_ALERTS=()
PSI_CPU=0; PSI_MEM=0; PSI_MEM_FULL=0; PSI_IO=0; PSI_IO_FULL=0

# DEVPS_PSI_DIR points the reader at fixtures, so the thresholds below are
# testable without having to thrash a real machine to reach them
psi_read() {
  local d=${DEVPS_PSI_DIR:-${WSLPS_PSI_DIR:-/proc/pressure}} out
  [ -r "$d/cpu" ] || { PSI_OK=0; return 1; }
  out=$(awk '
    function pct(s,   v) { sub(/^.*avg10=/, "", s); sub(/ .*$/, "", s); return int(v = s * 100 + 0.5) }
    FILENAME ~ /cpu$/    && /^some/ { c = pct($0) }
    FILENAME ~ /memory$/ && /^some/ { m = pct($0) }
    FILENAME ~ /memory$/ && /^full/ { mf = pct($0) }
    FILENAME ~ /io$/     && /^some/ { i = pct($0) }
    FILENAME ~ /io$/     && /^full/ { iff = pct($0) }
    END { printf "%d %d %d %d %d", c, m, mf, i, iff }
  ' "$d/cpu" "$d/memory" "$d/io") || return 1
  read -r PSI_CPU PSI_MEM PSI_MEM_FULL PSI_IO PSI_IO_FULL <<< "$out"
  PSI_OK=1
}

# The warning thresholds, in one place. Memory "full" at 10% of the last ten
# seconds means the box spent one second of it with every task stalled.
psi_alerts() {
  PSI_ALERTS=()
  [ "$PSI_OK" = 1 ] || return 0
  [ "$PSI_MEM_FULL" -ge 1000 ] &&
    PSI_ALERTS+=("crit|! memory thrashing - every task stalled $(pctstr "$PSI_MEM_FULL") of the last 10s")
  [ "$PSI_MEM_FULL" -lt 1000 ] && [ "$PSI_MEM" -ge 2000 ] &&
    PSI_ALERTS+=("warn|! memory pressure $(pctstr "$PSI_MEM") - something is waiting on RAM")
  [ "$PSI_IO_FULL" -ge 1000 ] &&
    PSI_ALERTS+=("crit|! disk stalled $(pctstr "$PSI_IO_FULL") of the last 10s - paging or heavy IO")
  [ "$PSI_IO_FULL" -lt 1000 ] && [ "$PSI_IO" -ge 3000 ] &&
    PSI_ALERTS+=("warn|! disk pressure $(pctstr "$PSI_IO") - IO is the bottleneck, not CPU")
  [ "$PSI_CPU" -ge 5000 ] &&
    PSI_ALERTS+=("warn|! CPU contention $(pctstr "$PSI_CPU") - tasks are queueing for a core")
  return 0
}

pctstr() { printf '%d.%d%%' $(( $1 / 100 )) $(( $1 % 100 / 10 )); }

# one pressure figure as a short bar plus its percentage
psi_cell() {
  local h=$1 col=$C_G
  [ "$h" -ge 1000 ] && col=$C_Y
  [ "$h" -ge 3000 ] && col=$C_R
  printf '%s %s%5s%s' "$(abar $(( h / 10 )) 6)" "$col" "$(pctstr "$h")" "$C_0"
}

# ---------------------------------------------------------------- helpers ----
bar() {
  local pm
  pm=$(awk -v u="$1" -v t="$2" 'BEGIN{
    p = (t > 0) ? u / t : 0
    if (p < 0) p = 0
    if (p > 1) p = 1
    printf "%d", p * 1000 + 0.5
  }')
  printf '%s %3d%%' "$(abar "$pm" "${3:-24}")" $(( (pm + 5) / 10 ))
}

hum_kb() { awk "$AWKLIB"' BEGIN { print hum(ARGV[1]) }' "$1"; }

# shorten() redacts on the way past, which covers every table built from a
# snapshot. These three read ps straight into a printf, so they filter here.
redact_line() { awk "$AWKLIB"'{ print redact($0) }'; }

# snapshot -> TSV, rss desc:
#   1 pid  2 rss_kb  3 swap_kb  4 etimes  5 pcpu  6 group  7 args
#   8 cputicks  9 ppid  10 io_bytes
# Columns 8-10 are counters, not rates: a caller that wants a rate takes two
# snapshots and divides by the time between them.
DP_IO=0        # reading /proc/<pid>/io for every process is a third of the
               # snapshot's cost, so only the callers that show it opt in
snapshot() { "snapshot_$DP_PLATFORM"; }

snapshot_linux() {
  ps -eo pid=,ppid=,rss=,etimes=,pcpu=,args= --sort=-rss |
    awk -v wantio="$DP_IO" "$AWKCAT"'
  function swapkb(pid,   f, line, p, v) {
    f = "/proc/" pid "/status"; v = 0
    while ((getline line < f) > 0)
      if (line ~ /^VmSwap:/) { split(line, p, /[ \t]+/); v = p[2] + 0; break }
    close(f)
    return v
  }
  function iobytes(pid,   f, line, p, v) {
    # real block IO, not rchar/wchar: those count page-cache hits too, and the
    # question this answers is who is actually reaching the disk. Readable only
    # for your own processes; anything else reports 0.
    if (!wantio) return 0
    f = "/proc/" pid "/io"; v = 0
    while ((getline line < f) > 0)
      if (line ~ /^(read_bytes|write_bytes):/) { split(line, p, /[ \t]+/); v += p[2] + 0 }
    close(f)
    return v
  }
  function ticks(pid,   f, line, p) {
    f = "/proc/" pid "/stat"
    if ((getline line < f) > 0) {
      sub(/^[0-9]+ \(.*\) /, "", line)
      split(line, p, " ")
      close(f)
      return p[12] + p[13]
    }
    close(f)
    return 0
  }
  {
    pid = $1; ppid = $2; rss = $3 + 0; et = $4 + 0; pc = $5 + 0
    args = ""
    for (i = 6; i <= NF; i++) args = args (i > 6 ? " " : "") $i
    if (args ~ /^\[/) next
    printf "%s\t%d\t%d\t%d\t%s\t%s\t%s\t%d\t%s\t%d\n", pid, rss, swapkb(pid), et, pc,
           cat(args), args, ticks(pid), ppid, iobytes(pid)
  }'
}

# Darwin has no /proc, so everything the Linux snapshot reads per pid has to
# come out of ps itself:
#   -m    sort by memory descending, the BSD spelling of --sort=-rss
#   -ww   never truncate args to the terminal width
#   time  cumulative CPU as [[DD-]HH:]MM:SS.ss - hundredths, so a two second
#         dashboard tick still sees movement
# etime and time arrive as clock strings rather than numbers, so both are
# parsed back here; every consumer downstream expects seconds and ticks.
#
# Columns 3 (swap) and 10 (io) are 0 and cannot be otherwise. Darwin compresses
# memory instead of swapping per process, and exposes no readable per-process
# block IO counter. Both are reported absent, not estimated.
snapshot_darwin() {
  ps -ww -eo pid=,ppid=,rss=,etime=,pcpu=,time=,args= -m | awk "$AWKCAT$AWKSECS"'
  {
    pid = $1; ppid = $2; rss = $3 + 0; et = secs($4); pc = $5 + 0
    tk = secs($6) * 100          # CLK_TCK is 100 on Darwin as it is on Linux
    args = ""
    for (i = 7; i <= NF; i++) args = args (i > 7 ? " " : "") $i
    if (args == "" || args ~ /^\[/) next
    printf "%s\t%d\t%d\t%d\t%s\t%s\t%s\t%d\t%s\t%d\n", pid, rss, 0, et, pc,
           cat(args), args, tk, ppid, 0
  }'
}

SNAP=""
snap() { if [ -n "$SNAP" ]; then printf '%s\n' "$SNAP"; else snapshot; fi; }

valid_group() { case " $DP_GROUPS " in *" $1 "*) return 0 ;; *) return 1 ;; esac; }

# Groups that may be read but never signalled in bulk. build_protected shields
# pid 1 and the caller's own ancestors and nothing else, so "kill group system"
# would SIGTERM every daemon the OS is running - several hundred of them on a
# Mac - and take the session with it. Reading them is useful; stopping them as
# a set never is.
DP_UNKILLABLE="system"
killable_group() { case " $DP_UNKILLABLE " in *" $1 "*) return 1 ;; *) return 0 ;; esac; }

# ----------------------------------------------------------------- header ----
header() {
  local mt ma st sf su l1 l5 l15 cores dstate warned=0
  mt=$(meminfo MemTotal);  ma=$(meminfo MemAvailable)
  st=$(meminfo SwapTotal); sf=$(meminfo SwapFree); su=$(( st - sf ))
  read -r l1 l5 l15 <<< "$(loadavg)"
  cores=$(cpu_cores)
  dstate=$(dstate_count)

  printf '%s%s %s RESOURCES %s %s%s  up %s%s\n\n' "$C_B" "$C_C" "$DP_LABEL" "$C_0" \
    "$C_DIM" "$(date '+%a %d %b %H:%M')" "$(uptime_pretty)" "$C_0"
  printf '  %-6s %s   %s used of %s  %s(%s available)%s\n' "RAM" \
    "$(bar $(( mt - ma )) "$mt")" "$(hum_kb $(( mt - ma )))" "$(hum_kb "$mt")" \
    "$C_DIM" "$(hum_kb "$ma")" "$C_0"
  if [ "$st" -gt 0 ]; then
    printf '  %-6s %s   %s used of %s  %s(%s free)%s\n' "SWAP" \
      "$(bar "$su" "$st")" "$(hum_kb "$su")" "$(hum_kb "$st")" "$C_DIM" \
      "$(hum_kb "$sf")" "$C_0"
  fi
  printf '  %-6s %s   %s / %s / %s  %sacross %s cores%s\n' "LOAD" \
    "$(bar "$l1" "$cores")" "$l1" "$l5" "$l15" "$C_DIM" "$cores" "$C_0"

  psi_read || true
  if [ "$PSI_OK" = 1 ]; then
    printf '  %-6s %s cpu   %s mem   %s io   %s(stalled, last 10s)%s\n' "STALL" \
      "$(psi_cell "$PSI_CPU")" "$(psi_cell "$PSI_MEM")" "$(psi_cell "$PSI_IO")" \
      "$C_DIM" "$C_0"
  fi

  echo
  local a
  psi_alerts
  for a in ${PSI_ALERTS[@]+"${PSI_ALERTS[@]}"}; do
    case "$a" in
      crit\|*) printf '  %s%s%s\n' "$C_R" "${a#*|}" "$C_0" ;;
      *)       printf '  %s%s%s\n' "$C_Y" "${a#*|}" "$C_0" ;;
    esac
    warned=1
  done
  if [ "$st" -gt 0 ] && [ $(( su * 100 / st )) -ge 80 ]; then
    printf '  %s! swap is %d%% full - the box is paging heavily%s\n' "$C_R" \
      $(( su * 100 / st )) "$C_0"; warned=1
  fi
  if [ $(( ma * 100 / mt )) -le 15 ]; then
    printf '  %s! only %s available RAM (%d%%) - close something%s\n' "$C_R" \
      "$(hum_kb "$ma")" $(( ma * 100 / mt )) "$C_0"; warned=1
  fi
  # load average and the D-state count are proxies for pressure; only fall back
  # to them on a kernel without PSI, where they are all there is
  if [ "$PSI_OK" != 1 ]; then
    if awk -v l="$l1" -v c="$cores" 'BEGIN{exit !(l > c * 1.5)}'; then
      printf '  %s! load %s on %s cores - CPU saturated%s\n' "$C_Y" "$l1" "$cores" "$C_0"
      warned=1
    fi
    if [ "$dstate" -gt 0 ]; then
      printf '  %s! %d process(es) in D state (blocked on disk / page-in)%s\n' "$C_Y" \
        "$dstate" "$C_0"; warned=1
    fi
  fi
  if [ "$warned" = 1 ]; then
    printf '  %stry: %s idle    then: %s kill port <n>%s\n' "$C_DIM" "$PROG" "$PROG" "$C_0"
  else
    printf '  %sall clear%s\n' "$C_G" "$C_0"
  fi
  echo
}

# ----------------------------------------------------------------- tables ----
group_table() {
  snap | awk -F'\t' -v ORDER="$DP_GROUPS" -v CB="$C_B" -v CD="$C_DIM" -v C0="$C_0" \
  -v GCOLS="$GCOLS_STR" \
  "$AWKLIB"'
  { n[$6]++; r[$6] += $2; s[$6] += $3; tn++; tr += $2; ts += $3 }
  END {
    ng = split(ORDER, o, " ")
    printf "%sGROUPS%s\n", CB, C0
    printf "  %-12s %6s %9s %9s\n", "GROUP", "COUNT", "RAM", "SWAP"
    for (i = 1; i <= ng; i++) {
      best = -1; bi = 0
      for (j = 1; j <= ng; j++) {
        g = o[j]
        if (done[g] || !(g in n)) continue
        if (r[g] > best) { best = r[g]; bi = j }
      }
      if (!bi) break
      g = o[bi]; done[g] = 1
      w = (tr > 0) ? int(r[g] * 100 / tr / 4 + 0.5) : 0
      b = ""; for (k = 0; k < w; k++) b = b "#"
      printf "  %s%-12s%s %6d %9s %9s   %s%s%s\n", gcol(g), g, C0, n[g], hum(r[g]),
             (s[g] > 0 ? hum(s[g]) : "-"), CD, b, C0
    }
    printf "  %s%-12s %6d %9s %9s%s\n\n", CD, "TOTAL", tn, hum(tr),
           (ts > 0 ? hum(ts) : "-"), C0
  }'
}

# proc_table <title> <limit> <rss|swap> <groupfilter> <showgroupcol>
proc_table() {
  local title="$1" limit="$2" sortf="$3" gf="$4" showg="$5" input
  input=$(snap)
  [ "$sortf" = swap ] && input=$(printf '%s\n' "$input" | sort -t$'\t' -k3,3nr)
  [ -n "$gf" ] && input=$(printf '%s\n' "$input" | awk -F'\t' -v g="$gf" '$6 == g')
  if [ -z "$input" ]; then
    printf '%s%s%s\n  %s(none)%s\n\n' "$C_B" "$title" "$C_0" "$C_DIM" "$C_0"
    return
  fi
  printf '%s%s%s\n' "$C_B" "$title" "$C_0"
  printf '%s\n' "$input" | head -n "$limit" | awk -F'\t' -v SHOWG="$showg" \
    -v C0="$C_0" -v GCOLS="$GCOLS_STR" "$AWKLIB"'
  BEGIN {
    if (SHOWG) printf "  %7s %8s %8s  %-11s %8s  %s\n", "PID","RAM","SWAP","GROUP","UPTIME","COMMAND"
    else       printf "  %7s %8s %8s %8s  %s\n",        "PID","RAM","SWAP","UPTIME","COMMAND"
  }
  {
    sw = ($3 > 0 ? hum($3) : "-")
    if (SHOWG) printf "  %7s %8s %8s  %s%-11s%s %8s  %s\n", $1, hum($2), sw,
                      gcol($6), $6, C0, dur($4), shorten($7, 58)
    else       printf "  %7s %8s %8s %8s  %s\n",        $1, hum($2), sw, dur($4), shorten($7, 66)
  }'
  echo
}

ports_table() {
  local rows port pid rss args ramcol
  rows=$(listeners)
  printf '%sLISTENING PORTS%s\n' "$C_B" "$C_0"
  if [ -z "$rows" ]; then printf '  %s(nothing listening)%s\n\n' "$C_DIM" "$C_0"; return; fi
  printf '  %7s %8s %8s  %s\n' "PORT" "PID" "RAM" "PROCESS"
  while IFS=$'\t' read -r port pid; do
    rss=""; args=""
    if [ -z "$pid" ]; then
      args="${C_DIM}(another user - run: sudo $PROG ports)${C_0}"
    elif pid_alive "$pid"; then
      rss=$(ps -o rss= -p "$pid" | tr -d ' ')
      args=$(ps -o args= -p "$pid" | redact_line | cut -c1-58)
    else
      args="${C_DIM}(exited)${C_0}"
    fi
    if [ -n "$rss" ]; then ramcol=$(hum_kb "$rss"); else ramcol="-"; fi
    printf '  %7s %8s %8s  %s\n' "$port" "${pid:--}" "$ramcol" "$args"
  done <<< "$rows"
  echo
}

# ------------------------------------------------------------ process tree ----
descendants() {
  local k
  for k in $(pgrep -P "$1" || true); do echo "$k"; descendants "$k"; done
}

ancestors() {
  local p="$1"
  while [ -n "$p" ] && [ "$p" -gt 1 ]; do
    echo "$p"
    p=$(ps -o ppid= -p "$p" | tr -d ' ' || true)
  done
}

# a bare interactive shell / session leader - never climb past one of these
is_boundary() {
  local a
  a=$(ps -o args= -p "$1" | redact_line | sed 's/^ *//' || true)
  [ -z "$a" ] && return 0
  case "$a" in
    -bash|-zsh|-sh|bash|zsh|sh|fish|login|init|/sbin/init) return 0 ;;
    /lib/systemd/systemd*|sshd*|tmux*|screen*)             return 0 ;;
  esac
  return 1
}

PROTECTED=""
build_protected() { PROTECTED=" 1 $$ $(ancestors $$ | tr '\n' ' ') "; }
is_protected() { case "$PROTECTED" in *" $1 "*) return 0 ;; *) return 1 ;; esac; }

# climb from a listener pid to the top-most process still part of that server
climb() {
  local cur="$1" parent
  while true; do
    parent=$(ps -o ppid= -p "$cur" | tr -d ' ' || true)
    [ -n "$parent" ] || break
    [ "$parent" -le 1 ] && break
    is_protected "$parent" && break
    is_boundary "$parent" && break
    cur="$parent"
  done
  echo "$cur"
}

tree_cmd() {
  local pid="$1" p
  pid_alive "$pid" || die "no such process: $pid"
  printf '%sPROCESS TREE from %s%s\n' "$C_B" "$pid" "$C_0"
  { echo "$pid"; descendants "$pid"; } | sort -un | while read -r p; do
      if pid_alive "$p"; then ps -o pid=,rss=,args= -p "$p"; fi
    done | sort -k2,2nr | awk "$AWKLIB"'
      BEGIN { printf "  %7s %8s  %s\n", "PID", "RAM", "COMMAND" }
      { a = ""; for (i = 3; i <= NF; i++) a = a (i > 3 ? " " : "") $i
        printf "  %7s %8s  %s\n", $1, hum($2), shorten(a, 64); t += $2; n++ }
      END { printf "  %7s %8s  %s\n", "", hum(t), n " process(es) total" }'
  echo
}

# ------------------------------------------------------------------- kill ----
kill_cmd() {
  local kind="" target="" assume_yes=0 sig=TERM dry=0 a r p
  local -a roots=() pids=() skipped=() all=() climbed=()

  for a in "$@"; do
    case "$a" in
      -y|--yes)     assume_yes=1 ;;
      -9|--force)   sig=KILL ;;
      -d|--dry-run) dry=1 ;;
      port|pid|group|project)
        if [ -z "$kind" ]; then kind="$a"; else target="$a"; fi ;;
      *)
        if [ -z "$kind" ]; then
          die "kill needs: port <n> | pid <n> | group <name> | project <name>"
        fi
        target="$a" ;;
    esac
  done
  if [ -z "$kind" ] || [ -z "$target" ]; then
    die "usage: $PROG kill port <n> | pid <n> | group <name> | project <name>   [-y] [-9] [-d]"
  fi

  build_protected

  case "$kind" in
    port)
      case "$target" in *[!0-9]*) die "port must be a number" ;; esac
      mapfile -t roots < <(listeners |
        awk -F'\t' -v p="$target" '$1 == p && $2 != "" { print $2 }' | sort -u)
      [ "${#roots[@]}" -gt 0 ] || die "nothing is listening on port $target (try: $PROG ports)"
      for r in "${roots[@]}"; do climbed+=("$(climb "$r")"); done
      mapfile -t roots < <(printf '%s\n' "${climbed[@]}" | sort -u)
      ;;
    pid)
      case "$target" in *[!0-9]*) die "pid must be a number" ;; esac
      pid_alive "$target" || die "no such process: $target"
      [ "$target" -le 1 ] && die "refusing to kill pid $target (init) - that would take down WSL"
      is_protected "$target" && die "pid $target is your own shell or session - refusing"
      roots=("$target")
      ;;
    group)
      valid_group "$target" || die "unknown group '$target' (valid: $DP_GROUPS)"
      killable_group "$target" || die "refusing to stop the '$target' group.
       Those are the operating system's own processes, not yours, and nothing
       here is safe to signal as a set. If you really mean one of them, name it:
       $PROG kill pid <n>"
      mapfile -t roots < <(snapshot | awk -F'\t' -v g="$target" '$6 == g { print $1 }')
      [ "${#roots[@]}" -gt 0 ] || die "no processes in group '$target'"
      ;;
    project)
      local hits distinct
      hits=$(project_pids "$target")
      [ -n "${hits//[[:space:]]/}" ] || die "no processes for project '$target' (try: $PROG projects)"
      distinct=$(printf '%s\n' "$hits" | cut -f1 | sort -u)
      if [ "$(printf '%s\n' "$distinct" | grep -c .)" -gt 1 ]; then
        die "'$target' matches more than one project - name the path:
$(printf '%s\n' "$distinct" | sed 's/^/    /')"
      fi
      mapfile -t roots < <(printf '%s\n' "$hits" | cut -f2 | sort -un)
      ;;
  esac

  for r in "${roots[@]}"; do
    if is_protected "$r"; then skipped+=("$r"); continue; fi
    all+=("$r")
    mapfile -t -O "${#all[@]}" all < <(descendants "$r")
  done
  if [ "${#all[@]}" -eq 0 ]; then
    printf '%sNothing to kill - every match is your own session%s\n' "$C_Y" "$C_0"
    return 1
  fi

  for p in $(printf '%s\n' "${all[@]}" | sort -un); do
    pid_alive "$p" || continue
    if is_protected "$p"; then skipped+=("$p"); else pids+=("$p"); fi
  done

  if [ "${#pids[@]}" -eq 0 ]; then
    printf '%sNothing to kill' "$C_Y"
    [ "${#skipped[@]}" -gt 0 ] && printf ' - every match is your own session'
    printf '%s\n' "$C_0"
    return 1
  fi

  # One snapshot answers both the table and the totals. It used to fork a ps
  # per victim for the rows and re-read /proc/<pid>/status for the cost, which
  # asked the kernel for the same numbers twice and tied the preview to Linux.
  # snapshot already carries pid, rss, swap, etimes and args for both.
  #
  # A victim missing from the snapshot still gets a row. It is a pid we are
  # about to signal, and silently dropping it would understate what is being
  # stopped - the same failure as showing no rows at all.
  local vic
  vic=$( { printf 'P\t%s\n' "${pids[@]}"; snapshot; } | awk -F'\t' '
    $1 == "P" { want[$2] = 1; order[++n] = $2; next }
    ($1 in want) { seen[$1] = 1; print }
    END { for (i = 1; i <= n; i++)
            if (!(order[i] in seen)) printf "%s\t0\t0\t0\t0\t?\t?\n", order[i] }')

  printf '%sWILL STOP%s  %s(SIG%s)%s\n' "$C_B" "$C_0" "$C_DIM" "$sig" "$C_0"
  printf '%s\n' "$vic" | awk -F'\t' "$AWKLIB"'
    BEGIN { printf "  %7s %8s %8s  %s\n", "PID", "RAM", "UPTIME", "COMMAND" }
    { printf "  %7s %8s %8s  %s\n", $1, hum($2), dur($4), shorten($7, 56) }'

  local freed
  freed=$(printf '%s\n' "$vic" | awk -F'\t' '
    { r += $2; s += $3 } END { print r "+" s }')
  printf '  %s%d process(es), frees about %s RAM and %s swap%s\n' "$C_DIM" \
    "${#pids[@]}" "$(hum_kb "${freed%%+*}")" "$(hum_kb "${freed##*+}")" "$C_0"

  if [ "${#skipped[@]}" -gt 0 ]; then
    printf '  %skeeping %d pid(s) - your own shell/session: %s%s\n' \
      "$C_G" "${#skipped[@]}" "${skipped[*]}" "$C_0"
  fi

  if [ "$dry" = 1 ]; then
    printf '\n  %sdry run - nothing was killed%s\n' "$C_Y" "$C_0"; return 0
  fi

  if [ "$assume_yes" != 1 ]; then
    local reply=""
    if [ -r /dev/tty ]; then
      printf '\n%sProceed? [y/N] %s' "$C_Y" "$C_0"
      read -r reply < /dev/tty || true
    else
      die "not a terminal - rerun with -y to confirm"
    fi
    case "$reply" in y|Y|yes|YES) ;; *) printf 'aborted\n'; return 1 ;; esac
  fi

  for p in "${pids[@]}"; do
    if pid_alive "$p"; then kill "-$sig" "$p" || true; fi
  done

  local i=0 alive=0
  while [ "$i" -lt 20 ]; do
    alive=0
    for p in "${pids[@]}"; do
      if pid_alive "$p"; then alive=$(( alive + 1 )); fi
    done
    [ "$alive" -eq 0 ] && break
    sleep 0.25; i=$(( i + 1 ))
  done

  if [ "$alive" -eq 0 ]; then
    printf '%s  stopped %d process(es)%s\n' "$C_G" "${#pids[@]}" "$C_0"
  else
    printf '%s  %d process(es) ignored SIG%s - rerun with -9 to force%s\n' \
      "$C_Y" "$alive" "$sig" "$C_0"
  fi
}

# ------------------------------------------------------------------ views ----
# Two snapshots <gap> apart, the second annotated the way the dashboard
# annotates its own: 11 instant cpu%, 12 is-new (always 0 here), 13 io bytes/s.
# ps reports a lifetime average, which says a process that was busy an hour ago
# is busy now. Two samples say what is happening at this moment.
snapshot_rate() {
  local gap=${1:-0.3} f us1 dt hz
  hz=$(getconf CLK_TCK) || hz=100
  f=$(mktemp -t devps.XXXXXX) || die "cannot create a temp file"
  us1=${EPOCHREALTIME/[.,]/}
  snapshot | awk -F'\t' '{ print $1 "\t" $8 "\t" $10 }' > "$f"
  sleep "$gap"
  dt=$(( ${EPOCHREALTIME/[.,]/} - us1 ))
  snapshot | awk -F'\t' -v dt="$dt" -v hz="$hz" -v pf="$f" '
    FILENAME == pf { pv[$1] = $2; pb[$1] = $3; next }
    { c = 0; io = 0
      if (dt > 0 && ($1 in pv)) {
        c  = ($8 - pv[$1]) * 1000000 * 100 / (hz * dt)
        io = ($10 - pb[$1]) * 1000000 / dt
      }
      if (c < 0) c = 0
      if (c > 999) c = 999
      if (io < 0) io = 0
      printf "%s\t%.1f\t0\t%d\n", $0, c, io }' "$f" -
  rm -f "$f"
}

# The idle/orphan predicate, shared by "devps idle" and the dashboard's idle
# view so the same question cannot get two answers. Input is snapshot columns
# plus 11 = instant cpu%, which both callers produce; output appends a reason.
# shellcheck disable=SC2016  # an awk program: $6 and friends are its fields
IDLE_AWK='
  { dev = ($6 ~ /^(dev-server|mcp|browser|node|webserver)$/)
    # ppid 1 means the shell that started it has gone. Restricted to the groups
    # you start by hand: plenty of system daemons live at ppid 1 by design and
    # are not "left behind" at all.
    orphan = ($9 == 1 && $2 > 20000 && (dev || $6 == "ai-agent"))
    idle   = (dev && $4 > 1200 && $11 < 1.0 && $2 > 20000)
    if (!orphan && !idle) next
    print $0, (orphan && idle) ? "idle+orphan" : (orphan ? "orphan" : "idle") }
'

idle_cmd() {
  printf '%sIDLE - alive a while, doing nothing, or left behind (kill candidates)%s\n' "$C_B" "$C_0"
  printf '  %sidle: up > 20 min, CPU < 1%% right now, RAM > 20M%s\n' "$C_DIM" "$C_0"
  printf '  %sorphan: its parent is gone, so nobody is watching it any more%s\n' "$C_DIM" "$C_0"
  local rows
  DP_IO=0
  rows=$(snapshot_rate 0.3 | awk -F'\t' -v OFS='\t' "$IDLE_AWK" | sort -t$'\t' -k2,2nr)
  if [ -z "${rows//[[:space:]]/}" ]; then
    printf '  %s(nothing obviously idle or orphaned)%s\n\n' "$C_DIM" "$C_0"; return
  fi
  printf '%s\n' "$rows" | awk -F'\t' -v CD="$C_DIM" -v C0="$C_0" -v CY="$C_Y" -v CR="$C_R" \
    "$AWKLIB"'
    BEGIN { printf "  %7s %8s %8s %7s %8s  %-11s %s\n",
                   "PID","RAM","SWAP","CPU%","UPTIME","WHY","COMMAND" }
    { printf "  %7s %8s %8s %6.1f%% %8s  %s%-11s%s %s\n", $1, hum($2), ($3 > 0 ? hum($3) : "-"),
             $11, dur($4), ($14 ~ /orphan/ ? CR : CY), $14, C0, shorten($7, 44)
      r += $2; s += $3; n++ }
    END { printf "  %sstopping all %d would return %s RAM and %s swap%s\n", CD, n, hum(r), hum(s), C0 }'
  echo
}

port_cmd() {
  local port="$1" pid root
  case "$port" in *[!0-9]*) die "port must be a number" ;; esac
  pid=$(listeners |
    awk -F'\t' -v p="$port" '$1 == p && $2 != "" { print $2 }' | sort -u | head -1)
  [ -n "$pid" ] || die "nothing listening on port $port (try: $PROG ports)"
  build_protected
  root=$(climb "$pid")
  printf '%sPORT %s%s\n' "$C_B" "$port" "$C_0"
  printf '  listener pid : %s\n' "$pid"
  printf '  command      : %s\n' "$(ps -o args= -p "$pid" | redact_line | cut -c1-70)"
  printf '  started      : %s\n' "$(ps -o lstart= -p "$pid" | sed 's/^ *//')"
  printf '  project dir  : %s\n' "$(proc_cwd "$pid" || echo '?')"
  printf '  server root  : %s  %s<- what "%s kill port %s" targets%s\n' \
    "$root" "$C_DIM" "$PROG" "$port" "$C_0"
  echo
  tree_cmd "$root"
}

# -------------------------------------------------------------- dashboard ----
# A live, keyboard-driven view. The render tick runs ~8x a second so bars ease
# and the spinner turns; the (far more expensive) process sample only runs
# every DASH_INT seconds. Nothing here signals anything on its own - `x` hands
# the selection to the same kill_cmd the CLI uses, guards and confirm included.

DASH_VIEWS="overview procs idle ports groups projects"
DASH_VIEW=overview
DASH_INT=2
DASH_PAUSED=0
DASH_SEL=0
DASH_TOP=0
DASH_SORT=rss
# Sortable columns, in cycle order. swap and io are dropped where the platform
# cannot fill them: sorting rows that are all zero is not a ranking, it is the
# snapshot's own order under a "TOP BY SWAP" heading - the same reason the swap
# command refuses. Derived like DASH_VIEWS so the key and the label agree.
DASH_SORTS="rss cpu swap io uptime"
[ "$DP_PLATFORM" = linux ] || DASH_SORTS="rss cpu uptime"
DASH_FILTER=""
DASH_MSG=""
DASH_HELP=0
DIRTY=1
LAST_SEC=0
TROWS=24; TCOLS=80
FRAME=0
LAST_US=0
SAMPLE_US=0
RENDER_S=0.12
CLK_TCK=100
PREVF=""
SNAP_ROWS=""
POINTER=">"
OUT=()
VIEW_ROWS=(); VIEW_PIDS=(); VIEW_PORTS=(); VIEW_KEYS=(); VIEW_HDR=""
OVER_PORTS=(); OVER_GROUPS=(); HDR_PORTS=""; HDR_GROUPS=""
# read through a nameref in push_hist and _spark, which shellcheck cannot see
# shellcheck disable=SC2034
HIST_RAM=() HIST_CPU=() HIST_SWP=() HIST_PSI=()
EASE_RAM=0; EASE_SWP=0; EASE_CPU=0
TGT_RAM=0;  TGT_SWP=0;  TGT_CPU=0
MEM_T=1; MEM_A=0; SW_T=0; SW_F=0
CPU_PREV_IDLE=0; CPU_PREV_TOT=0
L1=0.00; L5=0.00; L15=0.00; CORES=1
DSTATE=0
UPSTR=""
ALERTS=()

uptime_h() {
  local s d h m
  s=$(uptime_secs)
  d=$(( s / 86400 )); h=$(( s % 86400 / 3600 )); m=$(( s % 3600 / 60 ))
  if   [ "$d" -gt 0 ]; then printf 'up %dd%dh' "$d" "$h"
  elif [ "$h" -gt 0 ]; then printf 'up %dh%02dm' "$h" "$m"
  else                      printf 'up %dm' "$m"
  fi
}

read_mem() { "read_mem_$DP_PLATFORM"; [ "$MEM_T" -gt 0 ] || MEM_T=1; }

read_mem_darwin() {
  local t a st sf
  read -r t a st sf <<< "$(darwin_mem_kb)"
  MEM_T=${t:-1}; MEM_A=${a:-0}; SW_T=${st:-0}; SW_F=${sf:-0}
}

read_mem_linux() {
  local k v
  MEM_T=1; MEM_A=0; SW_T=0; SW_F=0
  while read -r k v _; do
    case "$k" in
      MemTotal:)     MEM_T=$v ;;
      MemAvailable:) MEM_A=$v ;;
      SwapTotal:)    SW_T=$v ;;
      SwapFree:)     SW_F=$v; break ;;
    esac
  done < /proc/meminfo
}

# whole-box CPU from the delta between two /proc/stat reads - the real number,
# not the lifetime average ps reports
read_cpu() { "read_cpu_$DP_PLATFORM"; }

# Darwin publishes no cumulative CPU counter - there is no kern.cp_time, and
# iostat would cost a blocking second per tick. The delta of every process's
# CPU time over the wall clock between two samples measures the same thing
# from the other end: busy ticks divided by the ticks the cores could have
# served. It misses kernel time no process is charged for, so it reads a
# little low, and a process exiting between samples shrinks the sum - which
# clamps to 0 rather than showing a negative spike.
CPU_PREV_US=0
read_cpu_darwin() {
  local tot us dt_us cap d_tot
  tot=$(ps -eo time= | awk "$AWKSECS"'
    { s += secs($1) }
    END { printf "%d", s * 100 }')
  us=${EPOCHREALTIME/[.,]/}
  dt_us=$(( us - CPU_PREV_US ))
  d_tot=$(( tot - CPU_PREV_TOT ))
  if [ "$CPU_PREV_US" -gt 0 ] && [ "$dt_us" -gt 0 ]; then
    # ticks the box could have served: cores * 100 ticks/s * dt
    cap=$(( $(cpu_cores) * dt_us / 10000 ))
    [ "$cap" -gt 0 ] && TGT_CPU=$(( d_tot * 1000 / cap ))
    [ "$TGT_CPU" -lt 0 ] && TGT_CPU=0
    [ "$TGT_CPU" -gt 1000 ] && TGT_CPU=1000
  fi
  CPU_PREV_TOT=$tot; CPU_PREV_US=$us
}

read_cpu_linux() {
  local u n s i rest v tot idle d_tot d_idle
  read -r _ u n s i rest < /proc/stat
  tot=$(( u + n + s + i ))
  for v in $rest; do tot=$(( tot + v )); done
  idle=$i
  d_tot=$(( tot - CPU_PREV_TOT )); d_idle=$(( idle - CPU_PREV_IDLE ))
  CPU_PREV_TOT=$tot; CPU_PREV_IDLE=$idle
  [ "$d_tot" -gt 0 ] && TGT_CPU=$(( (d_tot - d_idle) * 1000 / d_tot ))
  [ "$TGT_CPU" -lt 0 ] && TGT_CPU=0
  [ "$TGT_CPU" -gt 1000 ] && TGT_CPU=1000
}

push_hist() { # <array name> <value> - keep the last 32 samples
  local -n arr=$1
  arr+=("$2")
  [ "${#arr[@]}" -gt 32 ] && arr=("${arr[@]: -32}")
  return 0
}

ease() { # <variable> <target> - close 40% of the gap, in place
  local -n cur=$1
  local d=$(( $2 - cur ))
  if [ "${d#-}" -le 6 ]; then cur=$2; else cur=$(( cur + d * 40 / 100 )); fi
}

# ---- sampling -------------------------------------------------------------
dash_sample() {
  local us dt
  us=${EPOCHREALTIME/[.,]/}; dt=$(( us - LAST_US )); [ "$LAST_US" -eq 0 ] && dt=0
  LAST_US=$us; SAMPLE_US=$us

  DP_IO=1
  read_mem; read_cpu
  UPSTR=$(uptime_h)
  read -r L1 L5 L15 <<< "$(loadavg)"
  psi_read || true
  if [ "$PSI_OK" != 1 ]; then
    # only worth a fork on a kernel with no PSI, where it is the best proxy
    DSTATE=$(dstate_count)
  fi

  TGT_RAM=$(( (MEM_T - MEM_A) * 1000 / MEM_T ))
  if [ "$SW_T" -gt 0 ]; then TGT_SWP=$(( (SW_T - SW_F) * 1000 / SW_T )); else TGT_SWP=0; fi
  push_hist HIST_RAM "$TGT_RAM"
  push_hist HIST_SWP "$TGT_SWP"
  push_hist HIST_CPU "$TGT_CPU"
  push_hist HIST_PSI $(( PSI_MEM / 10 ))

  ALERTS=()
  psi_alerts
  local a
  for a in ${PSI_ALERTS[@]+"${PSI_ALERTS[@]}"}; do ALERTS+=("${a#*|}"); done
  if [ "$SW_T" -gt 0 ] && [ "$TGT_SWP" -ge 800 ]; then
    ALERTS+=("! swap is $(( TGT_SWP / 10 ))% full - the box is paging heavily")
  fi
  if [ $(( MEM_A * 100 / MEM_T )) -le 15 ]; then
    ALERTS+=("! only $(humb "$MEM_A") available RAM ($(( MEM_A * 100 / MEM_T ))%) - close something")
  fi
  [ "$PSI_OK" != 1 ] && [ "$DSTATE" -gt 0 ] &&
    ALERTS+=("! $DSTATE process(es) in D state (blocked on disk / page-in)")

  SNAP=$(snapshot)
  # join the previous tick counts in, so each row carries a real instant CPU%
  # match on FILENAME, not NR == FNR: on the very first sample the previous
  # file is empty, and the NR == FNR idiom then swallows every row of stdin
  SNAP_ROWS=$(printf '%s\n' "$SNAP" | awk -F'\t' -v dt="$dt" -v hz="$CLK_TCK" -v pf="$PREVF" '
    FILENAME == pf { prev[$1] = $2; prevby[$1] = $3; seen = 1; next }
    { c = 0; isnew = 0; io = 0
      if (dt > 0 && ($1 in prev)) {
        c  = ($8 - prev[$1]) * 1000000 * 100 / (hz * dt)
        io = ($10 - prevby[$1]) * 1000000 / dt
      } else if (dt > 0 && seen) isnew = 1
      if (c < 0) c = 0
      if (c > 999) c = 999
      if (io < 0) io = 0
      printf "%s\t%.1f\t%d\t%d\n", $0, c, isnew, io }' "$PREVF" -)
  printf '%s\n' "$SNAP" | awk -F'\t' '{ print $1 "\t" $8 "\t" $10 }' > "$PREVF"
  DIRTY=1
  dash_build
}

# ---- row builders ---------------------------------------------------------
# each fills VIEW_ROWS (rendered) plus VIEW_PIDS / VIEW_PORTS (parallel keys)
dash_build() {
  VIEW_ROWS=(); VIEW_PIDS=(); VIEW_PORTS=(); VIEW_KEYS=(); OVER_PORTS=(); OVER_GROUPS=()
  case "$DASH_VIEW" in
    ports)    VIEW_HDR=$(dash_hdr_ports) ;;
    groups)   VIEW_HDR=$(dash_hdr_groups) ;;
    projects) VIEW_HDR=$(dash_hdr_projects) ;;
    idle)     VIEW_HDR=$(dash_hdr_proc WHY) ;;
    *)        VIEW_HDR=$(dash_hdr_proc) ;;
  esac
  if [ "$DASH_VIEW" = overview ]; then
    # the same three blocks the one-shot report prints, in the same order
    local praw
    HDR_PORTS=$(dash_hdr_ports); HDR_GROUPS=$(dash_hdr_groups)
    praw=$(dash_port_raw)
    [ -n "${praw//[[:space:]]/}" ] && mapfile -t OVER_PORTS < <(dash_port_fmt "$praw")
    mapfile -t OVER_GROUPS < <(dash_group_lines)
  fi
  case "$DASH_VIEW" in
    overview) dash_rows_proc 15 ;;
    procs)    dash_rows_proc 0 ;;
    idle)     dash_rows_idle ;;
    ports)    dash_rows_ports ;;
    groups)   dash_rows_groups ;;
    projects) dash_rows_projects ;;
  esac
  local n=${#VIEW_ROWS[@]}
  [ "$DASH_SEL" -ge "$n" ] && DASH_SEL=$(( n > 0 ? n - 1 : 0 ))
  [ "$DASH_SEL" -lt 0 ] && DASH_SEL=0
  return 0
}

dash_sortkey() {
  case "$DASH_SORT" in
    cpu) printf '11' ;; swap) printf '3' ;; io) printf '13' ;; uptime) printf '4' ;; *) printf '2' ;;
  esac
}

dash_rows_proc() {
  local limit="$1" key rows
  key=$(dash_sortkey)
  rows=$(printf '%s\n' "$SNAP_ROWS" | sort -t$'\t' -k"$key","$key"nr)
  # index(), not ~: a filter is whatever the user typed. As an ERE, "c++" would
  # quietly match every c, and "[" would abort awk and empty the view
  [ -n "$DASH_FILTER" ] && rows=$(printf '%s\n' "$rows" | awk -F'\t' -v f="$DASH_FILTER" \
    'BEGIN { f = tolower(f) } index(tolower($7), f) || $1 == f || index($6, f)')
  [ "$limit" -gt 0 ] && rows=$(printf '%s\n' "$rows" | head -n "$limit")
  [ -z "${rows//[[:space:]]/}" ] && return 0
  mapfile -t VIEW_ROWS < <(printf '%s\n' "$rows" | dash_fmt_proc)
  mapfile -t VIEW_PIDS < <(printf '%s\n' "$rows" | cut -f1)
  return 0
}

dash_rows_idle() {
  local rows
  # the same predicate the CLI uses: SNAP_ROWS already carries the instant cpu
  # in column 11, so nothing here needs its own idea of what "idle" means
  rows=$(printf '%s\n' "$SNAP_ROWS" | awk -F'\t' -v OFS='\t' "$IDLE_AWK" \
    | sort -t$'\t' -k2,2nr)
  [ -z "${rows//[[:space:]]/}" ] && return 0
  mapfile -t VIEW_ROWS < <(printf '%s\n' "$rows" | dash_fmt_proc why)
  mapfile -t VIEW_PIDS < <(printf '%s\n' "$rows" | cut -f1)
  return 0
}

# rows never carry a leading marker column - dash_render owns that, so the
# selection pointer cannot be eaten by a colour reset inside the row
dash_fmt_proc() {
  awk -F'\t' -v WHY="${1:-}" -v W="$TCOLS" -v CD="$C_DIM" -v C0="$C_0" -v CR="$C_R" -v CY="$C_Y" \
      -v CG="$C_G" -v CN="$C_NEW" -v GCOLS="$GCOLS_STR" \
      -v BLKS="$(IFS=,; printf '%s' "${BLK[*]}")" -v EMPTY="$BAR_EMPTY" "$AWKLIB"'
  function micro(v, mx, w,   f, s, i) {
    if (mx <= 0) mx = 1
    f = int(v * w / mx + 0.5); if (f > w) f = w
    s = ""
    for (i = 0; i < w; i++) s = s (i < f ? blk[8] : EMPTY)
    return s
  }
  BEGIN { split(BLKS, blk, ",")
          wide = (W >= 108)
          cmdw = W - (wide ? 82 : 54); if (cmdw < 12) cmdw = 12 }
  { rows[NR] = $0
    if ($2 + 0 > mx) mx = $2 + 0
    if ($11 + 0 > mxc) mxc = $11 + 0
    if ($13 + 0 > mxio) mxio = $13 + 0 }
  END {
    for (i = 1; i <= NR; i++) {
      split(rows[i], f, "\t")
      cpu = f[11] + 0
      cc  = (cpu >= 60) ? CR : (cpu >= 15) ? CY : CD
      rc  = (f[2] + 0 > mx * 0.5) ? CR : (f[2] + 0 > mx * 0.2) ? CY : CG
      pc  = (f[12] == 1) ? CN : CD
      sw  = (f[3] + 0 > 0) ? hum(f[3]) : "-"
      swc = (f[3] + 0 > 0) ? CY : CD
      io  = f[13] + 0
      ioc = (io > 1048576) ? CR : (io > 0) ? CY : CD
      # the idle view answers "why is this here", every other view "what is it"
      tag  = (WHY != "") ? f[14] : f[6]
      tagc = (WHY == "") ? gcol(f[6]) : (f[14] ~ /orphan/ ? CR : CY)
      if (wide)
        printf "%s%7s%s %s%8s%s %s%s%s %s%7s%s %s%5.1f%%%s %s%8s%s %s%8s%s %s%-10s%s %s\n",
          pc, f[1], C0, rc, hum(f[2]), C0, rc, micro(f[2], mx, 8), C0,
          swc, sw, C0, cc, cpu, C0,
          ioc, (io > 0 ? hum(io / 1024) "/s" : "-"), C0,
          CD, dur(f[4]), C0, tagc, tag, C0, shorten(f[7], cmdw)
      else
        printf "%s%7s%s %s%8s%s %s%7s%s %s%5.1f%%%s %s%8s%s %s\n",
          pc, f[1], C0, rc, hum(f[2]), C0, swc, sw, C0,
          cc, cpu, C0, CD, dur(f[4]), C0, shorten(f[7], cmdw)
    }
  }'
}

dash_hdr_proc() {
  local last=${1:-GROUP}
  if [ "$TCOLS" -ge 108 ]; then
    printf '%7s %8s %8s %7s %6s %8s %8s %-10s %s' PID RAM "" SWAP "CPU%" "IO/s" UPTIME "$last" COMMAND
  else
    printf '%7s %8s %7s %6s %8s %s' PID RAM SWAP "CPU%" UPTIME COMMAND
  fi
}

# the raw "port<TAB>pid" list, and the formatter that joins it to the sample -
# split apart so the overview can render the same rows without the selection
dash_port_raw() {
  listeners
}

dash_port_fmt() {
  printf '%s\n%s\n' "$SNAP_ROWS" "$1" | awk -F'\t' \
    -v CD="$C_DIM" -v C0="$C_0" -v CG="$C_G" -v CY="$C_Y" -v W="$TCOLS" -v PROG="$PROG" "$AWKLIB"'
    NF > 3 { rss[$1] = $2; args[$1] = $7; cpu[$1] = $11 + 0; next }
    { pid = $2
      cmd = (pid in args) ? shorten(args[pid], W - 42) \
          : (pid == "" ? ("(another user - run: sudo " PROG " ports)") : "(exited)")
      printf "%s%7s%s %s%8s%s %s%8s%s %s%5.1f%%%s  %s\n",
        CG, $1, C0, CD, (pid == "" ? "-" : pid), C0,
        CY, (pid in rss ? hum(rss[pid]) : "-"), C0,
        CD, (pid in cpu ? cpu[pid] : 0), C0, cmd }'
}

dash_rows_ports() {
  local rows
  rows=$(dash_port_raw)
  [ -z "${rows//[[:space:]]/}" ] && return 0
  mapfile -t VIEW_ROWS   < <(dash_port_fmt "$rows")
  mapfile -t VIEW_PIDS   < <(printf '%s\n' "$rows" | cut -f2)
  mapfile -t VIEW_PORTS  < <(printf '%s\n' "$rows" | cut -f1)
  return 0
}

dash_hdr_ports() { printf '%7s %8s %8s %6s  %s' PORT PID RAM "CPU%" PROCESS; }

dash_group_lines() {
  printf '%s\n' "$SNAP_ROWS" | awk -F'\t' -v ORDER="$DP_GROUPS" \
    -v CD="$C_DIM" -v C0="$C_0" -v CG="$C_G" -v CY="$C_Y" -v CR="$C_R" -v GCOLS="$GCOLS_STR" \
    -v BLKS="$(IFS=,; printf '%s' "${BLK[*]}")" -v EMPTY="$BAR_EMPTY" "$AWKLIB"'
    { n[$6]++; r[$6] += $2; s[$6] += $3; c[$6] += $11; io[$6] += $13; tr += $2; tn++ }
    END {
      split(BLKS, blk, ",")
      ng = split(ORDER, o, " ")
      for (i = 1; i <= ng; i++) {
        best = -1; bi = 0
        for (j = 1; j <= ng; j++) { g = o[j]
          if (done[g] || !(g in n)) continue
          if (r[g] > best) { best = r[g]; bi = j } }
        if (!bi) break
        g = o[bi]; done[g] = 1
        w = (tr > 0) ? int(r[g] * 24 / tr + 0.5) : 0
        b = ""
        for (k = 0; k < 24; k++) b = b (k < w ? blk[8] : EMPTY)
        printf "%s%-12s%s %s%5d%s %s%9s%s %s%8s%s %s%5.1f%%%s %s%8s%s  %s%s%s\n",
          gcol(g), g, C0, CD, n[g], C0, CG, hum(r[g]), C0,
          CY, (s[g] > 0 ? hum(s[g]) : "-"), C0, CD, c[g], C0,
          (io[g] > 1048576 ? CR : CD), (io[g] > 0 ? hum(io[g] / 1024) "/s" : "-"), C0,
          CG, b, C0
      }
    }'
}

dash_rows_groups() {
  mapfile -t VIEW_ROWS < <(dash_group_lines)
  return 0
}

dash_hdr_groups() { printf '%-12s %5s %9s %8s %6s %8s  %s' GROUP COUNT RAM SWAP "CPU%" "IO/s" SHARE; }

dash_rows_projects() {
  local rows
  rows=$(project_scan)
  [ -z "${rows//[[:space:]]/}" ] && return 0
  mapfile -t VIEW_ROWS < <(printf '%s\n' "$rows" | awk -F'\t' -v CD="$C_DIM" -v C0="$C_0" \
    -v CG="$C_G" -v CY="$C_Y" -v CC="$C_C" -v CR="$C_R" -v HOME="$HOME" -v W="$TCOLS" "$AWKLIB"'
    function tilde(p) { sub("^" HOME "/", "~/", p); return p }
    { printf "%s%5d%s %s%9s%s %s%8s%s  %s%-12s%s %s%s%s\n",
        CD, $2, C0, CG, hum($3), C0, ($4 > 0 ? CY : CD), ($4 > 0 ? hum($4) : "-"), C0,
        CC, substr($5, 1, 12), C0, ($6 ? CR : ""), shorten(tilde($1), W - 42), C0 }')
  mapfile -t VIEW_KEYS < <(printf '%s\n' "$rows" | cut -f1)
  return 0
}

dash_hdr_projects() { printf '%5s %9s %8s  %-12s %s' PROCS RAM SWAP PORTS PROJECT; }

# ---- painting -------------------------------------------------------------
dash_line() { OUT+=("$1"); }

# The format strings below are deliberately held in a variable: each row is
# printed twice, once with colour and once plain, and the two must not drift
# apart or the width budget is wrong. They are literals in this file, never
# anything a user supplies.
# shellcheck disable=SC2059
dash_header() {
  local sp bw pulse a line plain paused="" used total blank12="            "
  sp=${SPIN[$(( FRAME / 2 % ${#SPIN[@]} ))]}
  ease EASE_RAM "$TGT_RAM"
  ease EASE_SWP "$TGT_SWP"
  ease EASE_CPU "$TGT_CPU"
  bw=$(( TCOLS - 62 )); [ "$bw" -gt 26 ] && bw=26; [ "$bw" -lt 8 ] && bw=8
  [ "$DASH_PAUSED" = 1 ] && paused="${C_Y}   PAUSED"

  printf -v line ' %s%s%s %s%s%s %s%s%s   %s%(%a %d %b %H:%M:%S)T  %s  every %ss%s%s' \
    "$C_ACC" "$sp" "$C_0" "$C_HEAD" "${PROG^^}" "$C_0" "$C_ACC" "$DASH_VIEW" "$C_0" \
    "$C_DIM" -1 "$UPSTR" "$DASH_INT" "$paused" "$C_0"
  OUT+=("$line")

  # Every row here builds a plain twin of itself, so the sparkline can be given
  # the columns that are actually left. Without that the line wraps, and
  # dash_paint positions rows absolutely, so a wrap eats the row below it.
  local fmt=' %sRAM%s %s %s%4d%%%s %8s of %-8s '
  _abar "$EASE_RAM" "$bw"; local rambar=$REPLY
  _humb $(( MEM_T - MEM_A )); used=$REPLY
  _humb "$MEM_T"; total=$REPLY
  printf -v line  "$fmt" "$C_B" "$C_0" "$rambar" "$C_B" $(( (EASE_RAM + 5) / 10 )) "$C_0" "$used" "$total"
  printf -v plain "$fmt" "" "" "" "" $(( (EASE_RAM + 5) / 10 )) "" "$used" "$total"
  _spark HIST_RAM 1000 $(( TCOLS - ${#plain} - bw ))
  OUT+=("${line}${REPLY}${C_0}")

  if [ "$SW_T" -gt 0 ]; then
    fmt=' %sSWP%s %s %s%4d%%%s %8s of %-8s '
    _abar "$EASE_SWP" "$bw"; local swpbar=$REPLY
    _humb $(( SW_T - SW_F )); used=$REPLY
    _humb "$SW_T"; total=$REPLY
    printf -v line  "$fmt" "$C_B" "$C_0" "$swpbar" "$C_B" $(( (EASE_SWP + 5) / 10 )) "$C_0" "$used" "$total"
    printf -v plain "$fmt" "" "" "" "" $(( (EASE_SWP + 5) / 10 )) "" "$used" "$total"
    _spark HIST_SWP 1000 $(( TCOLS - ${#plain} - bw ))
    OUT+=("${line}${REPLY}${C_0}")
  fi

  fmt=' %sCPU%s %s %s%4d%%%s %sload %s %s %s on %s cores%s '
  _abar "$EASE_CPU" "$bw"; local cpubar=$REPLY
  printf -v line  "$fmt" "$C_B" "$C_0" "$cpubar" "$C_B" $(( (EASE_CPU + 5) / 10 )) "$C_0" \
    "$C_DIM" "$L1" "$L5" "$L15" "$CORES" "$C_0"
  printf -v plain "$fmt" "" "" "" "" $(( (EASE_CPU + 5) / 10 )) "" "" "$L1" "$L5" "$L15" "$CORES" ""
  _spark HIST_CPU 1000 $(( TCOLS - ${#plain} - bw ))
  OUT+=("${line}${REPLY}${C_0}")

  if [ "$PSI_OK" = 1 ]; then
    # three fixed 12-column cells; the label is the first thing to go
    local lbl="stalled, last 10s"
    [ "$TCOLS" -lt 100 ] && lbl=""
    fmt=' %sSTL%s %s cpu %s mem %s io  %s%s%s '
    printf -v line  "$fmt" "$C_B" "$C_0" "$(psi_cell "$PSI_CPU")" "$(psi_cell "$PSI_MEM")" \
      "$(psi_cell "$PSI_IO")" "$C_DIM" "$lbl" "$C_0"
    printf -v plain "$fmt" "" "" "$blank12" "$blank12" "$blank12" "" "$lbl" ""
    _spark HIST_PSI 1000 $(( TCOLS - ${#plain} ))
    OUT+=("${line}${REPLY}${C_0}")
  fi

  if [ "${#ALERTS[@]}" -gt 0 ]; then
    # a slow pulse, so a real warning is hard to scroll past
    pulse=$C_R; [ $(( FRAME / 4 % 2 )) = 1 ] && pulse=$C_Y
    for a in "${ALERTS[@]}"; do OUT+=(" ${pulse}${a}${C_0}"); done
  elif [ -n "$DASH_FILTER" ]; then
    OUT+=(" ${C_G}all clear${C_0}${C_DIM}   filter: /${DASH_FILTER}${C_0}")
  else
    OUT+=(" ${C_G}all clear${C_0}")
  fi
  OUT+=("")
  return 0
}

dash_footer() {
  local keys tail
  # the hint line is the one row with no data in it, so it is the row that
  # gives way first: below 100 columns it keeps only the keys you cannot guess
  if [ "$TCOLS" -ge 100 ]; then
    case "$DASH_VIEW" in
      overview|procs|idle)
        keys="${C_ACC}up/dn${C_0} move  ${C_ACC}x${C_0} kill  ${C_ACC}t${C_0} tree  ${C_ACC}s${C_0} sort:${DASH_SORT}  ${C_ACC}/${C_0} filter" ;;
      ports)
        keys="${C_ACC}up/dn${C_0} move  ${C_ACC}x${C_0} kill port  ${C_ACC}t${C_0} tree" ;;
      projects)
        keys="${C_ACC}up/dn${C_0} move  ${C_ACC}x${C_0} kill project" ;;
      *)
        keys="${C_ACC}tab${C_0} next view" ;;
    esac
    tail="  ${C_ACC}$(dash_keyspan)${C_0} views  ${C_ACC}+ -${C_0} rate  ${C_ACC}p${C_0} pause  ${C_ACC}?${C_0} help  ${C_ACC}q${C_0} quit"
  else
    case "$DASH_VIEW" in
      overview|procs|idle)
        keys="${C_ACC}x${C_0} kill  ${C_ACC}t${C_0} tree  ${C_ACC}s${C_0} ${DASH_SORT}  ${C_ACC}/${C_0} filter" ;;
      ports|projects)
        keys="${C_ACC}x${C_0} kill" ;;
      *)
        keys="${C_ACC}tab${C_0} view" ;;
    esac
    tail="  ${C_ACC}$(dash_keyspan)${C_0} views  ${C_ACC}?${C_0} help  ${C_ACC}q${C_0} quit"
  fi
  OUT+=("")
  OUT+=(" ${C_DIM}${keys}${tail}${C_0}")
  [ -n "$DASH_MSG" ] && OUT+=(" $DASH_MSG")
  return 0
}

dash_help_panel() {
  OUT+=(" ${C_B}KEYS${C_0}")
  OUT+=("   ${C_ACC}1${C_0} overview  ${C_ACC}2${C_0} processes  ${C_ACC}3${C_0} idle  ${C_ACC}4${C_0} ports  ${C_ACC}5${C_0} groups  ${C_ACC}6${C_0} projects  ${C_ACC}tab${C_0} cycle")
  OUT+=("   ${C_ACC}up down / j k${C_0}  move the selection    ${C_ACC}pgup pgdn${C_0}  page")
  OUT+=("   ${C_ACC}s${C_0}   sort by rss, cpu, swap, io, uptime")
  OUT+=("   ${C_ACC}/${C_0}   filter on command, pid or group (empty line clears it)")
  OUT+=("   ${C_ACC}x${C_0}   stop the selected process - full preview, then it asks")
  OUT+=("   ${C_ACC}X${C_0}   the same, with SIGKILL")
  OUT+=("   ${C_ACC}t${C_0}   process tree for the selection")
  OUT+=("   ${C_ACC}p${C_0}   pause sampling    ${C_ACC}r${C_0}  resample now")
  OUT+=("   ${C_ACC}+ -${C_0} refresh interval  ${C_ACC}q${C_0}  quit")
  OUT+=("")
  OUT+=(" ${C_DIM}x and t drop out to the normal $PROG commands, so every kill guard${C_0}")
  OUT+=(" ${C_DIM}still applies: your own shell and session are never candidates.${C_0}")
  OUT+=("")
  OUT+=(" ${C_DIM}press any key to go back${C_0}")
  return 0
}

# Lay out the overview's ports and groups blocks and leave what is left for
# the process list in PROC_BUDGET. Sections give up rows to the process list
# rather than pushing it off the bottom - groups first, then ports.
PROC_BUDGET=3
dash_overview_head() {
  local avail=$1 before=${#OUT[@]} pn gn i guard=0 cost
  pn=${#OVER_PORTS[@]}; [ "$pn" -gt 5 ] && pn=5
  gn=${#OVER_GROUPS[@]}; [ "$gn" -gt 5 ] && gn=5
  # A section costs its rows plus a title, a column header, a trailing blank
  # and, when it is trimmed, one "... more" line. Count that exactly: guessing
  # low pushes the footer off the bottom of a short window.
  while : ; do
    cost=2
    [ "$pn" -gt 0 ] && cost=$(( cost + pn + 3 + (${#OVER_PORTS[@]} > pn ? 1 : 0) ))
    [ "$gn" -gt 0 ] && cost=$(( cost + gn + 3 + (${#OVER_GROUPS[@]} > gn ? 1 : 0) ))
    [ $(( avail - cost )) -ge 3 ] && break
    if   [ "$gn" -gt 0 ]; then gn=$(( gn - 1 ))
    elif [ "$pn" -gt 0 ]; then pn=$(( pn - 1 ))
    else break
    fi
    guard=$(( guard + 1 )); [ "$guard" -gt 24 ] && break
  done

  if [ "$pn" -gt 0 ]; then
    dash_line " ${C_B}LISTENING PORTS${C_0}"
    dash_line "  ${C_DIM}${HDR_PORTS}${C_0}"
    for (( i = 0; i < pn; i++ )); do dash_line "  ${OVER_PORTS[i]}"; done
    [ "${#OVER_PORTS[@]}" -gt "$pn" ] &&
      dash_line "  ${C_DIM}... $(( ${#OVER_PORTS[@]} - pn )) more, press 4${C_0}"
    dash_line ""
  fi
  if [ "$gn" -gt 0 ]; then
    dash_line " ${C_B}GROUPS${C_0}"
    dash_line "  ${C_DIM}${HDR_GROUPS}${C_0}"
    for (( i = 0; i < gn; i++ )); do dash_line "  ${OVER_GROUPS[i]}"; done
    [ "${#OVER_GROUPS[@]}" -gt "$gn" ] &&
      dash_line "  ${C_DIM}... $(( ${#OVER_GROUPS[@]} - gn )) more, press 5${C_0}"
    dash_line ""
  fi
  # what is left after the blocks, minus the two lines dash_render still owes
  # the process list (its title and its column header)
  PROC_BUDGET=$(( avail - (${#OUT[@]} - before) - 2 ))
  [ "$PROC_BUDGET" -lt 3 ] && PROC_BUDGET=3
  return 0
}

dash_render() {
  OUT=()
  dash_header
  if [ "$DASH_HELP" = 1 ]; then dash_help_panel; dash_paint; return 0; fi

  local n=${#VIEW_ROWS[@]} body i mark
  if [ "$DASH_VIEW" = overview ]; then
    dash_overview_head $(( TROWS - ${#OUT[@]} - 3 ))
    dash_line " ${C_B}TOP BY ${DASH_SORT^^}${C_0}"
    dash_line "  ${C_DIM}${VIEW_HDR}${C_0}"
    body=$PROC_BUDGET
  else
    dash_line "  ${C_DIM}${VIEW_HDR}${C_0}"
    body=$(( TROWS - ${#OUT[@]} - 3 ))
  fi
  [ "$body" -lt 3 ] && body=3
  [ "$DASH_SEL" -lt "$DASH_TOP" ] && DASH_TOP=$DASH_SEL
  [ "$DASH_SEL" -ge $(( DASH_TOP + body )) ] && DASH_TOP=$(( DASH_SEL - body + 1 ))
  [ "$DASH_TOP" -lt 0 ] && DASH_TOP=0

  if [ "$n" = 0 ]; then
    dash_line "  ${C_DIM}(nothing here)${C_0}"
  else
    for (( i = DASH_TOP; i < n && i < DASH_TOP + body; i++ )); do
      if [ "$i" = "$DASH_SEL" ] && { [ "${#VIEW_PIDS[@]}" -gt 0 ] || [ "${#VIEW_KEYS[@]}" -gt 0 ]; }; then
        mark="${C_ACC}${POINTER}${C_0} "
      else
        mark="  "
      fi
      dash_line "${mark}${VIEW_ROWS[i]}"
    done
    [ $(( DASH_TOP + body )) -lt "$n" ] && \
      dash_line "  ${C_DIM}... $(( n - DASH_TOP - body )) more${C_0}"
  fi
  dash_footer
  dash_paint
  return 0
}

# the cheap path: nothing changed but the spinner, so repaint one cell
dash_spin() {
  printf '\033[1;2H%s%s%s' "$C_ACC" "${SPIN[$(( FRAME / 2 % ${#SPIN[@]} ))]}" "$C_0"
}

# repaint in place: no clear-screen, so nothing flickers
dash_paint() {
  local out=$'\033[H' i n=${#OUT[@]}
  for (( i = 0; i < n && i < TROWS; i++ )); do
    out+=$'\033['$(( i + 1 ))$';1H\033[K'"${OUT[i]}"
  done
  out+=$'\033['$(( i + 1 ))$';1H\033[J'
  printf '%s' "$out"
}

# ---- input ----------------------------------------------------------------
dash_resize() {
  local sz
  sz=$(stty size <&3) || sz="24 80"
  TROWS=${sz%% *}; TCOLS=${sz##* }
  case "$TROWS$TCOLS" in *[!0-9]*) TROWS=24; TCOLS=80 ;; esac
  [ "$TROWS" -lt 10 ] && TROWS=10
  [ "$TCOLS" -lt 40 ] && TCOLS=40
  dash_build
}

# the number keys name views directly, so an unavailable one is refused here
# rather than in six places
# "1-6" or "1-5", and the view names in key order - help text that is derived
# from DASH_VIEWS rather than restating it cannot advertise a dead key
dash_keyspan() { local -a v; read -ra v <<< "$DASH_VIEWS"; printf '1-%d' "${#v[@]}"; }
dash_viewlist() {
  local -a v; read -ra v <<< "$DASH_VIEWS"
  printf '%s' "overview, processes, idle, ports, groups${v[5]+, projects}"
}

dash_sort_step() {
  local -a v; read -ra v <<< "$DASH_SORTS"
  local i n=${#v[@]}
  for (( i = 0; i < n; i++ )); do [ "${v[i]}" = "$DASH_SORT" ] && break; done
  DASH_SORT="${v[$(( (i + 1) % n ))]}"
  dash_build
}

dash_goto() {
  case " $DASH_VIEWS " in *" $1 "*) ;; *) return 0 ;; esac
  DASH_VIEW="$1"; DASH_SEL=0; DASH_TOP=0; dash_build
}

dash_view_step() {
  local -a v
  read -ra v <<< "$DASH_VIEWS"
  local i n=${#v[@]}
  for (( i = 0; i < n; i++ )); do [ "${v[i]}" = "$DASH_VIEW" ] && break; done
  dash_goto "${v[$(( (i + $1 + n) % n ))]}"
}

# One echoed line on the bottom row, answer left in REPLY. It must not print
# the answer: a command substitution would capture the prompt escapes as well,
# and they would end up inside the filter string.
dash_prompt() {
  REPLY=""
  printf '\033[%d;1H\033[K%s%s%s \033[?25h' "$TROWS" "$C_ACC" "$1" "$C_0"
  IFS= read -r -u 3 REPLY || REPLY=""
  printf '\033[?25l'
}

# leave the alternate screen, run a normal devps command, come back
dash_shell_out() {
  printf '\033[?1049l\033[?25h'
  "$@"
  printf '\n%spress any key to return to the dashboard%s' "$C_DIM" "$C_0"
  IFS= read -rsn1 -u 3 || true
  printf '\033[?1049h\033[?25l'
  dash_sample
}

# subshells, so a die() inside the normal command cannot take the TUI with it
dash_do_kill() { ( kill_cmd "$@" ) || true; }
dash_do_tree() { ( tree_cmd "$1" ) || true; }

dash_selected_pid() {
  [ "${#VIEW_PIDS[@]}" -gt "$DASH_SEL" ] || return 1
  local p=${VIEW_PIDS[$DASH_SEL]}
  [ -n "$p" ] || return 1
  printf '%s' "$p"
}

dash_keys() {
  local k rest pid
  IFS= read -rsn1 -t "$RENDER_S" -u 3 k || return 0
  if [ "$k" = $'\033' ]; then
    IFS= read -rsn2 -t 0.02 -u 3 rest || rest=""
    case "$rest" in
      "[A") k=up ;; "[B") k=down ;; "[C") k=right ;; "[D") k=left ;;
      "[5") IFS= read -rsn1 -t 0.02 -u 3 _ || true; k=pgup ;;
      "[6") IFS= read -rsn1 -t 0.02 -u 3 _ || true; k=pgdn ;;
      *)    k=esc ;;
    esac
  fi
  DIRTY=1
  if [ "$DASH_HELP" = 1 ]; then
    DASH_HELP=0
    case "$k" in q|esc) return 1 ;; esac
    return 0
  fi
  DASH_MSG=""
  case "$k" in
    q|esc)   return 1 ;;
    up|k)    DASH_SEL=$(( DASH_SEL - 1 )) ;;
    down|j)  DASH_SEL=$(( DASH_SEL + 1 )) ;;
    pgup)    DASH_SEL=$(( DASH_SEL - 10 )) ;;
    pgdn)    DASH_SEL=$(( DASH_SEL + 10 )) ;;
    1)       dash_goto overview ;;
    2)       dash_goto procs ;;
    3)       dash_goto idle ;;
    4)       dash_goto ports ;;
    5)       dash_goto groups ;;
    6)       dash_goto projects ;;
    $'\t'|right) dash_view_step 1 ;;
    left)    dash_view_step -1 ;;
    s)       dash_sort_step ;;
    p)       DASH_PAUSED=$(( 1 - DASH_PAUSED )) ;;
    r)       dash_sample ;;
    +|=)     [ "$DASH_INT" -lt 30 ] && DASH_INT=$(( DASH_INT + 1 )) ;;
    -|_)     [ "$DASH_INT" -gt 1 ]  && DASH_INT=$(( DASH_INT - 1 )) ;;
    '?'|h)   DASH_HELP=1 ;;
    /)       dash_prompt "filter:"; DASH_FILTER=$REPLY; dash_goto "$DASH_VIEW" ;;
    t)       if pid=$(dash_selected_pid); then dash_shell_out dash_do_tree "$pid"
             else DASH_MSG="${C_Y}nothing selected${C_0}"; fi ;;
    x)       if [ "$DASH_VIEW" = projects ] && [ "${#VIEW_KEYS[@]}" -gt "$DASH_SEL" ]; then
               case "${VIEW_KEYS[$DASH_SEL]}" in
                 /*) dash_shell_out dash_do_kill project "${VIEW_KEYS[$DASH_SEL]}" ;;
                 *)  DASH_MSG="${C_Y}that row is a bucket, not a project${C_0}" ;;
               esac
             elif [ "$DASH_VIEW" = ports ] && [ "${#VIEW_PORTS[@]}" -gt "$DASH_SEL" ]; then
               dash_shell_out dash_do_kill port "${VIEW_PORTS[$DASH_SEL]}"
             elif pid=$(dash_selected_pid); then
               dash_shell_out dash_do_kill pid "$pid"
             else DASH_MSG="${C_Y}nothing selected${C_0}"; fi ;;
    X)       if pid=$(dash_selected_pid); then dash_shell_out dash_do_kill pid "$pid" -9
             else DASH_MSG="${C_Y}nothing selected${C_0}"; fi ;;
  esac
  [ "$DASH_SEL" -ge "${#VIEW_ROWS[@]}" ] && DASH_SEL=$(( ${#VIEW_ROWS[@]} - 1 ))
  [ "$DASH_SEL" -lt 0 ] && DASH_SEL=0
  return 0
}

dash_cleanup() {
  printf '\033[?1049l\033[?25h\033[0m'
  [ -n "$PREVF" ] && rm -f "$PREVF"
}

dash_cmd() {
  local interval="${1:-2}" now
  case "$interval" in *[!0-9]*) die "watch interval must be a number" ;; esac
  [ "$interval" -lt 1 ] && interval=1
  DASH_INT=$interval

  # over a pipe, into a file, or with no controlling terminal there is nothing
  # interactive to do - fall back to the plain repeating report
  if [ ! -t 1 ] || [ ! -r /dev/tty ]; then watch_plain "$interval"; return; fi
  exec 3< /dev/tty || { watch_plain "$interval"; return; }

  [ "$UI_UNICODE" = 1 ] && POINTER="❯"
  CORES=$(cpu_cores)
  CLK_TCK=$(getconf CLK_TCK) || CLK_TCK=100
  PREVF=$(mktemp -t devps.XXXXXX) || die "cannot create a temp file"
  : > "$PREVF"

  trap 'dash_cleanup; exit 0' INT TERM
  trap 'dash_cleanup' EXIT
  trap 'dash_resize' WINCH
  printf '\033[?1049h\033[?25l'

  dash_resize
  read_cpu            # prime the delta, so the first frame is not a fake 100%
  dash_sample
  while true; do
    FRAME=$(( FRAME + 1 ))
    now=${EPOCHREALTIME/[.,]/}
    if [ "$DASH_PAUSED" = 0 ] &&
       [ $(( now - SAMPLE_US )) -ge $(( DASH_INT * 1000000 )) ]; then
      dash_sample
    fi
    # a full frame only when the data, the clock, an easing bar or a key says
    # so - otherwise just turn the spinner. A monitor that burns a core is a
    # bug in itself.
    if [ "$DIRTY" = 1 ] || [ "$EASE_RAM" != "$TGT_RAM" ] ||
       [ "$EASE_SWP" != "$TGT_SWP" ] || [ "$EASE_CPU" != "$TGT_CPU" ] ||
       [ "$EPOCHSECONDS" != "$LAST_SEC" ] || [ "${#ALERTS[@]}" -gt 0 ]; then
      dash_render
      DIRTY=0; LAST_SEC=$EPOCHSECONDS
    else
      dash_spin
    fi
    dash_keys || break
  done
  dash_cleanup
  trap - EXIT
}

# the old dumb refresh - still what you get over a pipe or without a tty
watch_plain() {
  local out
  trap 'printf "\033[?25h\n"; exit 0' INT TERM
  printf '\033[?25l'
  while true; do
    out=$(report 10)
    printf '\033[H\033[2J%s\n' "$out"
    sleep "${1:-3}"
  done
}

# ------------------------------------------------------------- projects ----
# Which project is costing you, rather than which process. Every process is
# attributed to the directory it was started in, walked up to the nearest
# project marker, so the five node processes of one dev server land on one row.
#
# cwd is only readable for your own processes; anything else lands in
# "unattributed", which is honest rather than silently wrong.
PROJECT_MARKERS='.git/HEAD .git package.json composer.json go.mod Cargo.toml pyproject.toml'

# every process's working directory as "C<TAB>pid<TAB>dir".
#
# Both implementations answer in one call rather than one per pid: on a box
# with 500 processes the per-pid version costs 500 forks to build a map that is
# thrown away a moment later. Processes owned by another user are absent from
# both - Linux gives an unreadable link, Darwin's lsof does not list them.
cwd_map() { "cwd_map_$DP_PLATFORM"; }

cwd_map_darwin() {
  # -d cwd restricts to the working-directory descriptor, -Fpn asks for the
  # field format: one p<pid> line per process, then n<path> for its cwd. -w
  # silences the warnings lsof would otherwise print for what it cannot open.
  lsof -w -a -d cwd -Fpn | awk '
    /^p/ { pid = substr($0, 2); next }
    /^n/ { if (pid != "") printf "C\t%s\t%s\n", pid, substr($0, 2) }'
}

cwd_map_linux() {
  # one ls, not one readlink per pid. Processes owned by another user have an
  # unreadable link and simply come back without a " -> " part.
  # shellcheck disable=SC2012  # find would walk into /proc, which costs far more
  ls -l /proc/[0-9]*/cwd 2>/dev/null | awk '
    { i = index($0, " -> ")
      if (!i) next
      link = substr($0, 1, i - 1)
      target = substr($0, i + 4)
      sub(/ \(deleted\)$/, "", target)
      if (match(link, /\/proc\/[0-9]+\/cwd$/))
        printf "C\t%s\t%s\n", substr(link, RSTART + 6, RLENGTH - 10), target }'
}

port_map() {
  listeners | awk -F'\t' '$2 != "" { printf "P\t%s\t%s\n", $2, $1 }' | sort -u
}

# the walk from a working directory up to its project root, shared by the
# view and by "kill project". Results are cached per directory: a dev server's
# processes nearly all share one cwd.
PROOTLIB='
  # read into a variable: a bare getline from a file overwrites the current
  # record and its fields, and this runs from inside a rule that still needs them
  function exists(f,   line, r) { r = (getline line < f); close(f); return r >= 0 }
  function ismark(p,   i, ok) {
    if (p in mc) return mc[p]
    ok = 0
    for (i = 1; i <= nm; i++) if (exists(p "/" m[i])) { ok = 1; break }
    return mc[p] = ok
  }
  function proot(d,   p) {
    if (d in rc) return rc[d]
    p = d
    # all the way to /: a pnpm store or a monorepo package can sit a dozen
    # levels under its own root, and a depth cap would quietly file those
    # processes under "not in a project"
    while (p != "" && p != "/") {
      if (ismark(p)) return rc[d] = p
      sub(/\/[^\/]*$/, "", p)
    }
    return rc[d] = ""
  }
  BEGIN { nm = split(MARK, m, " ") }
'

# TSV: root  procs  rss  swap  ports  onmnt   (rss desc, the buckets last)
project_scan() {
  { port_map; cwd_map; snap | sed 's/^/S\t/'; } | awk -F'\t' -v MARK="$PROJECT_MARKERS" \
  "$PROOTLIB"'
  $1 == "C" { cwd[$2] = $3; next }
  $1 == "P" { if (!($2 in pt) || index(pt[$2], $3) == 0) pt[$2] = pt[$2] (pt[$2] ? "," : "") $3; next }
  $1 == "S" {
    pid = $2; rss = $3 + 0; sw = $4 + 0
    if (!(pid in cwd)) { hn++; hr += rss; hs += sw; next }   # cwd not readable
    r = proot(cwd[pid])
    if (r == "") { un++; ur += rss; us += sw; next }          # no project marker
    if (!(r in n)) roots[++nr] = r
    n[r]++; rr[r] += rss; sr[r] += sw
    if (pid in pt) if (index(prt[r], pt[pid]) == 0)
      prt[r] = prt[r] (prt[r] ? "," : "") pt[pid]
  }
  END {
    for (k = 1; k <= nr; k++) {
      best = -1; bi = 0
      for (j = 1; j <= nr; j++) {
        r = roots[j]
        if (done[r] || !(r in n)) continue
        if (rr[r] > best) { best = rr[r]; bi = j }
      }
      if (!bi) break
      r = roots[bi]; done[r] = 1
      printf "%s\t%d\t%d\t%d\t%s\t%d\n", r, n[r], rr[r], sr[r],
             (prt[r] == "" ? "-" : prt[r]), (index(r, "/mnt/") == 1 ? 1 : 0)
    }
    if (un) printf "%s\t%d\t%d\t%d\t%s\t%d\n", "(not in a project)", un, ur, us, "-", 0
    if (hn) printf "%s\t%d\t%d\t%d\t%s\t%d\n", "(cwd not readable - other users)", hn, hr, hs, "-", 0
  }'
}

# "root<TAB>pid" for every process of the named project. The name matches a
# full path, a ~-relative path, or the last path component.
project_pids() {
  { cwd_map; snap | sed 's/^/S\t/'; } | awk -F'\t' -v MARK="$PROJECT_MARKERS" \
    -v WANT="$1" -v HOME="$HOME" "$PROOTLIB"'
    $1 == "C" { cwd[$2] = $3; next }
    $1 == "S" {
      pid = $2
      if (!(pid in cwd)) next
      r = proot(cwd[pid])
      if (r == "") next
      b = r; sub(/^.*\//, "", b)
      w = WANT; sub("^~/", HOME "/", w); sub("/$", "", w)
      if (r == w || b == WANT) printf "%s\t%s\n", r, pid
    }'
}

projects_cmd() {
  local rows mnt
  rows=$(project_scan)
  printf '%s%sPROJECTS%s %s(processes grouped by the project directory they run in)%s\n' \
    "" "$C_B" "$C_0" "$C_DIM" "$C_0"
  if [ -z "${rows//[[:space:]]/}" ]; then
    printf '  %s(nothing attributable)%s\n\n' "$C_DIM" "$C_0"
    return
  fi
  printf '%s\n' "$rows" | awk -F'\t' -v CD="$C_DIM" -v C0="$C_0" -v CG="$C_G" \
    -v CY="$C_Y" -v CC="$C_C" -v CR="$C_R" -v HOME="$HOME" "$AWKLIB"'
    function tilde(p) { sub("^" HOME "/", "~/", p); return p }
    BEGIN { printf "  %6s %9s %9s  %-14s %s\n", "PROCS", "RAM", "SWAP", "PORTS", "PROJECT" }
    { printf "  %s%6d%s %s%9s%s %s%9s%s  %s%-14s%s %s%s%s\n",
        CD, $2, C0, CG, hum($3), C0, ($4 > 0 ? CY : CD), ($4 > 0 ? hum($4) : "-"), C0,
        CC, substr($5, 1, 14), C0, ($6 ? CR : ""), tilde($1), C0
      t += $3; s += $4; n += $2 }
    END { printf "  %s%6d %9s %9s%s\n", CD, n, hum(t), (s > 0 ? hum(s) : "-"), C0 }'
  mnt=$(printf '%s\n' "$rows" | awk -F'\t' '$6 == 1 { print $1 }')
  if [ -n "$mnt" ]; then
    echo
    printf '  %s! on the Windows filesystem: %s%s\n' "$C_R" "$(printf '%s' "$mnt" | tr '\n' ' ')" "$C_0"
    printf '  %severy open and stat crosses the 9P bridge - metadata-heavy work\n' "$C_DIM"
    printf '  (git status, node_modules, installs) runs 10-100x slower there than\n'
    printf '  under %s. Moving the checkout is usually the single biggest win.%s\n' "$HOME" "$C_0"
  fi
  echo
}

# --------------------------------------------------------------- doctor ----
# Everything above answers "what is running". This answers "is this box set up
# to survive it": the WSL memory cap, whether freed memory ever goes back to
# Windows, whether the virtual disk can still grow, and whether your code is
# on the slow side of the 9P bridge.
#
# Every Windows-side lookup degrades to "unknown" rather than failing, so this
# still runs on a plain Linux box or with interop turned off.

is_wsl() { [ "$DP_PLATFORM" = linux ] && grep -qi microsoft /proc/version; }

DOC_FINDINGS=()
finding() { DOC_FINDINGS+=("$1|$2"); }   # crit|warn|ok|tip , text

# size string from .wslconfig ("10GB", "512MB", "8G") to KB, or empty
cfg_kb() {
  awk -v v="$1" 'BEGIN{
    s = toupper(v); n = s + 0
    if (n <= 0) { print ""; exit }
    if (s ~ /TB?$/) n *= 1024 * 1024 * 1024
    else if (s ~ /GB?$/) n *= 1024 * 1024
    else if (s ~ /MB?$/) n *= 1024
    else if (s ~ /KB?$/) n *= 1
    else n /= 1024                      # bare number is bytes
    printf "%d", n
  }'
}

declare -A CFG=()
CFG_PATH=""

CFG_AMBIGUOUS=0
read_wslconfig() {
  local f k v line n=0
  CFG=(); CFG_PATH=""; CFG_AMBIGUOUS=0
  # Ask Windows which profile is running WSL before guessing. A host with more
  # than one profile can easily have more than one .wslconfig, and reporting a
  # different user's memory cap is worse than reporting none.
  if [ -n "$WIN_PROFILE" ]; then
    f=$(wslpath -u "$WIN_PROFILE" 2>/dev/null)/.wslconfig
    [ -r "$f" ] && CFG_PATH="$f"
  fi
  if [ -z "$CFG_PATH" ]; then
    for f in /mnt/*/Users/*/.wslconfig; do
      [ -r "$f" ] || continue
      n=$(( n + 1 ))
      [ -z "$CFG_PATH" ] && CFG_PATH="$f"
    done
    [ "$n" -gt 1 ] && CFG_AMBIGUOUS=$n
  fi
  [ -n "$CFG_PATH" ] || return 1
  while IFS= read -r line; do
    k=${line%%=*}; v=${line#*=}
    CFG[$k]=$v
  done < <(awk '
    /^[[:space:]]*[;#]/ { next }
    /^[[:space:]]*\[/ { sec = $0; gsub(/[][[:space:]]/, "", sec); sec = tolower(sec); next }
    /=/ { k = $0; sub(/=.*/, "", k); v = $0; sub(/[^=]*=/, "", v)
          gsub(/^[[:space:]]+|[[:space:]]+$/, "", k)
          gsub(/^[[:space:]]+|[[:space:]]+$/, "", v)
          if (k != "") printf "%s.%s=%s\n", sec, tolower(k), v }
  ' "$CFG_PATH")
}

WIN_RAM_KB=""; WIN_PROFILE=""; WIN_DISTROS=""
read_windows() {
  command -v powershell.exe > /dev/null || return 1
  local out
  # one interop call, not three: each costs about a third of a second. The
  # distro list is name<TAB>path per line, because a BasePath can contain
  # spaces ("\Program Files\...") and must never be word-split.
  out=$(cd / && powershell.exe -NoProfile -Command \
    "(Get-CimInstance Win32_ComputerSystem).TotalPhysicalMemory
     \$env:USERPROFILE
     Get-ChildItem HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Lxss |
       ForEach-Object { \$p = Get-ItemProperty \$_.PSPath
                        \"\$(\$p.DistributionName)\`t\$(\$p.BasePath)\" }" \
    2>/dev/null | tr -d '\r') || return 1
  WIN_RAM_KB=$(printf '%s' "$out" | sed -n '1p' | awk '{ printf "%d", $1 / 1024 }')
  WIN_PROFILE=$(printf '%s' "$out" | sed -n '2p')
  WIN_DISTROS=$(printf '%s' "$out" | sed -n '3,$p')
  [ -n "$WIN_RAM_KB" ]
}

doc_row() { printf '    %-20s %s\n' "$1" "$2"; }

doctor_cmd() {
  local mt st mem_kb swap_kb vhdx vhdx_sz drive freek usedk pct f

  printf '%s%sWSL DOCTOR%s %s(configuration, not processes - nothing here changes anything)%s\n\n' \
    "" "$C_B" "$C_0" "$C_DIM" "$C_0"

  if ! is_wsl; then
    printf '  %sthis is not a WSL instance - the checks below are WSL-specific%s\n\n' \
      "$C_Y" "$C_0"
    return 0
  fi

  mt=$(meminfo MemTotal); st=$(meminfo SwapTotal)
  read_windows || true          # before the config: it says which profile to read

  # ---- .wslconfig --------------------------------------------------------
  printf '  %sCONFIG%s\n' "$C_B" "$C_0"
  if read_wslconfig; then
    doc_row "file" "$CFG_PATH"
    if [ "$CFG_AMBIGUOUS" -gt 0 ]; then
      doc_row "" "${C_Y}${CFG_AMBIGUOUS} profiles have one and interop is unavailable - this may not be yours${C_0}"
      finding warn "picked one of $CFG_AMBIGUOUS .wslconfig files without being able to ask Windows which profile runs WSL"
    fi
    # keys are folded to lower case when parsed; print them the way the docs
    # spell them, so a line can be copied straight back into the file
    for f in wsl2.memory:memory wsl2.processors:processors wsl2.swap:swap \
             wsl2.swapfile:swapFile wsl2.networkingmode:networkingMode \
             experimental.automemoryreclaim:autoMemoryReclaim \
             experimental.sparsevhd:sparseVhd; do
      [ -n "${CFG[${f%%:*}]:-}" ] && doc_row "${f#*:}" "${CFG[${f%%:*}]}"
    done
  else
    doc_row "file" "${C_Y}not found${C_0}"
  fi
  doc_row "guest sees" "$(hum_kb "$mt") RAM, $(nproc) cores, $(hum_kb "$st") swap"
  echo

  # ---- host --------------------------------------------------------------
  printf '  %sHOST%s\n' "$C_B" "$C_0"
  if [ -n "$WIN_RAM_KB" ]; then
    doc_row "windows RAM" "$(hum_kb "$WIN_RAM_KB")"
    mem_kb=$(cfg_kb "${CFG[wsl2.memory]:-}")
    if [ -n "$mem_kb" ]; then
      pct=$(( mem_kb * 100 / WIN_RAM_KB ))
      doc_row "WSL cap" "$(hum_kb "$mem_kb") = ${pct}% of host RAM"
      if [ "$pct" -ge 80 ]; then
        finding crit "memory=${CFG[wsl2.memory]} is ${pct}% of host RAM - Windows can run out of commit and kill the VM"
      fi
    else
      pct=$(( mt * 100 / WIN_RAM_KB ))
      finding warn "no memory= cap - WSL defaults to 50% of host RAM ($(hum_kb $(( WIN_RAM_KB / 2 ))))"
    fi
  else
    doc_row "windows RAM" "${C_DIM}unknown (no interop)${C_0}"
    [ -n "${CFG[wsl2.memory]:-}" ] || finding warn "no memory= cap in .wslconfig - WSL defaults to 50% of host RAM"
  fi
  echo

  # ---- memory returned to windows ---------------------------------------
  case "${CFG[experimental.automemoryreclaim]:-}" in
    "")            finding tip "autoMemoryReclaim is unset - freed memory stays inside the VM until you restart it" ;;
    disabled|off)  finding warn "autoMemoryReclaim=${CFG[experimental.automemoryreclaim]} - freed memory never goes back to Windows" ;;
    *)             finding ok "autoMemoryReclaim=${CFG[experimental.automemoryreclaim]} - freed memory returns to Windows" ;;
  esac

  swap_kb=$(cfg_kb "${CFG[wsl2.swap]:-}")
  if [ "${CFG[wsl2.swap]:-}" = "0" ]; then
    finding warn "swap=0 - when the cap is reached the OOM killer runs instead of paging"
  elif [ -n "$mem_kb" ] && [ -n "$swap_kb" ] && [ "$swap_kb" -lt $(( mem_kb / 4 )) ]; then
    finding tip "swap ($(hum_kb "$swap_kb")) is small next to the $(hum_kb "$mem_kb") cap - little headroom before the OOM killer"
  fi

  # ---- disk --------------------------------------------------------------
  printf '  %sDISK%s\n' "$C_B" "$C_0"
  vhdx=$(find_vhdx)
  if [ -n "$vhdx" ] && [ -r "$vhdx" ]; then
    vhdx_sz=$(stat -c %s "$vhdx")
    vhdx_sz=$(( vhdx_sz / 1024 ))
    drive=$(printf '%s' "$vhdx" | cut -d/ -f1-3)
    freek=$(df -Pk "$drive" | awk 'NR == 2 { print $4 }')
    usedk=$(df -Pk / | awk 'NR == 2 { print $3 }')
    doc_row "ext4.vhdx" "$(hum_kb "$vhdx_sz") on disk   $vhdx"
    doc_row "used inside" "$(hum_kb "$usedk") of $(df -Ph / | awk 'NR == 2 { print $2 }')"
    doc_row "host drive free" "$(hum_kb "$freek")"
    if [ "$freek" -lt 20971520 ]; then
      finding crit "only $(hum_kb "$freek") free where the VHDX lives - it grows on demand and cannot shrink past that"
    fi
    if [ "$vhdx_sz" -gt $(( usedk + usedk / 5 + 5242880 )) ]; then
      finding tip "VHDX is $(hum_kb "$vhdx_sz") but only $(hum_kb "$usedk") is used inside - sudo fstrim -a returns the slack"
    fi
  else
    doc_row "ext4.vhdx" "${C_DIM}not located${C_0}"
  fi
  case "${CFG[experimental.sparsevhd]:-}" in
    true|1) finding ok "sparseVhd=true - the VHDX shrinks as you delete files" ;;
    "")     finding tip "sparseVhd is unset - the VHDX grows forever and never shrinks on its own" ;;
    *)      finding warn "sparseVhd=${CFG[experimental.sparsevhd]} - the VHDX will not shrink on its own" ;;
  esac
  echo

  # ---- where the code lives ---------------------------------------------
  printf '  %sPROJECTS%s\n' "$C_B" "$C_0"
  local mnt
  mnt=$(project_scan | awk -F'\t' '$6 == 1 { print $1 }')
  if [ -n "$mnt" ]; then
    printf '%s\n' "$mnt" | while read -r f; do doc_row "on windows fs" "${C_R}${f}${C_0}"; done
    finding warn "code under /mnt is on the 9P bridge - metadata-heavy work runs 10-100x slower there"
  else
    doc_row "on windows fs" "none - everything is on ext4"
  fi
  echo

  # ---- right now ---------------------------------------------------------
  psi_read || true
  if [ "$PSI_OK" = 1 ]; then
    printf '  %sPRESSURE%s  %s(stalled share of the last 10s)%s\n' "$C_B" "$C_0" "$C_DIM" "$C_0"
    doc_row "cpu / mem / io" "$(pctstr "$PSI_CPU")  $(pctstr "$PSI_MEM")  $(pctstr "$PSI_IO")"
    psi_alerts
    for f in ${PSI_ALERTS[@]+"${PSI_ALERTS[@]}"}; do
      case "$f" in crit\|*) finding crit "${f#*|! }" ;; *) finding warn "${f#*|! }" ;; esac
    done
    echo
  fi

  # ---- findings ----------------------------------------------------------
  printf '  %sFINDINGS%s\n' "$C_B" "$C_0"
  local sev txt col
  for f in ${DOC_FINDINGS[@]+"${DOC_FINDINGS[@]}"}; do
    sev=${f%%|*}; txt=${f#*|}
    case "$sev" in
      crit) col=$C_R ;;
      warn) col=$C_Y ;;
      ok)   col=$C_G ;;
      *)    col=$C_C ;;
    esac
    printf '    %s%-5s%s %s\n' "$col" "$sev" "$C_0" "$txt"
  done
  [ "${#DOC_FINDINGS[@]}" -eq 0 ] && printf '    %snothing to flag%s\n' "$C_G" "$C_0"
  echo
  printf '  %sedit %s then run: wsl --shutdown  (from Windows) to apply%s\n\n' \
    "$C_DIM" "${CFG_PATH:-%USERPROFILE%\\.wslconfig}" "$C_0"
}

# The VHDX of *this* distro. Matching on the registry DistributionName matters:
# a host commonly has several (Docker Desktop registers two of its own), and
# pairing another distro's file size with this one's internal usage would make
# every disk finding meaningless. If the distro cannot be identified, say so
# rather than report a number for the wrong disk.
find_vhdx() {
  # Some registry paths carry an extended-length prefix that wslpath rejects.
  # It has to live in a variable: written inline the pattern silently fails to
  # strip anything, because the trailing backslash escapes the closing quote.
  local want=${WSL_DISTRO_NAME:-} dn base p unc=$'\\\\?\\'
  [ -n "$want" ] || return 1
  [ -n "$WIN_DISTROS" ] || read_windows || true
  if [ -n "$WIN_DISTROS" ]; then
    while IFS=$'\t' read -r dn base; do
      [ "$dn" = "$want" ] || continue
      base=${base#"$unc"}
      p=$(wslpath -u "$base" 2>/dev/null)/ext4.vhdx
      [ -r "$p" ] && { printf '%s' "$p"; return 0; }
    done <<< "$WIN_DISTROS"
  fi
  # no interop: the install path carries the distro name, so it can still be
  # matched rather than picking whichever file the glob happens to hit first
  for p in /mnt/*/Users/*/AppData/Local/Packages/*/LocalState/ext4.vhdx \
           /mnt/*/Users/*/AppData/Local/wsl/*/ext4.vhdx; do
    [ -r "$p" ] || continue
    case "${p,,}" in
      *"${want,,}"*) printf '%s' "$p"; return 0 ;;
    esac
  done
  return 1
}

